    function showBuildInfo(item, customAlert = null) {
      const banner = document.getElementById('build-info-banner');
      if (!item && !customAlert) {
        banner.style.display = 'none';
        return;
      }
      if (customAlert) {
        document.getElementById('bi-cat').textContent = 'COMMAND NOTICE';
        document.getElementById('bi-name').textContent = customAlert.title || 'Action Required';
        document.getElementById('bi-desc').textContent = customAlert.desc || '';
        document.getElementById('bi-cost').textContent = customAlert.sub || '';
        banner.style.display = 'flex';
        return;
      }
      const lvl = getItemLevel(item.id);
      const pwrPct = (lvl - 1) * 25;
      document.getElementById('bi-cat').textContent = `${item.cat} • ${item.rarity} (Lv.${lvl}${pwrPct > 0 ? ` +${pwrPct}%` : ''})`;
      document.getElementById('bi-name').textContent = item.name;
      document.getElementById('bi-desc').textContent = item.desc;
      document.getElementById('bi-cost').textContent = `Cost: ${item.cost.toLocaleString()} Gold`;
      banner.style.display = 'flex';
    }

    function renderBuildHotbar() {
      syncActiveLoadoutToBuildItems();
      const container = document.getElementById('dock-hotbar-slots');
      if (!container) return;
      container.innerHTML = BUILD_ITEMS.map(item => {
        const sel = State.selectedBuildSlot === item.slot ? 'selected-slot' : '';
        const afford = State.gold >= item.cost ? 'can-afford' : '';
        const iconSvg = getItemIconSvg(item);
        return `
          <div class="hotbar-slot ${sel}" data-slot="${item.slot}" title="Slot ${item.slot}: ${item.name} (${item.costLabel})">
            <span class="slot-key">${item.slot}</span>
            <svg viewBox="0 0 24 24" style="width:18px; height:18px; margin-top:4px;">${iconSvg}</svg>
            <div class="slot-cost ${afford}" data-slot-cost="${item.slot}">${item.costLabel}</div>
          </div>
        `;
      }).join('');

      container.querySelectorAll('.hotbar-slot').forEach(el => {
        const slotNum = parseInt(el.dataset.slot, 10);
        const item = BUILD_ITEMS.find(b => b.slot === slotNum);
        el.addEventListener('mouseenter', () => showBuildInfo(item));
        el.addEventListener('mouseleave', () => {
          const activeItem = BUILD_ITEMS.find(b => b.slot === State.selectedBuildSlot);
          showBuildInfo(activeItem || null);
        });
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          if (State.selectedBuildSlot === slotNum) {
            State.selectedBuildSlot = null;
            showBuildInfo(null);
          } else {
            State.selectedBuildSlot = slotNum;
            showBuildInfo(item);
          }
          renderBuildHotbar();
        });
      });
    }

