    }

    .btn-modal-close:hover {
      background: #ef4444;
      color: #fff;
      border-color: #fca5a5;
    }

    /* Pixelated Block Scrollbars */
    * {
      scrollbar-width: thin;
      scrollbar-color: #38bdf8 #080d18;
    }

    *::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    *::-webkit-scrollbar-track {
      background: #080d18;
      border: 2px solid #1e2f4d;
      border-radius: 0;
    }

    *::-webkit-scrollbar-thumb {
      background: #28416e;
      border: 2px solid #38bdf8;
      border-radius: 0;
    }

    *::-webkit-scrollbar-thumb:hover {
      background: #38bdf8;
    }

