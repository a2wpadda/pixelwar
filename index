    function claimTile(x, y, newOwnerId) {
      const idx = y * MAP_W + x;
      const oldOwnerId = mapOwner[idx];
      if (oldOwnerId === newOwnerId) return;
      if (oldOwnerId > 0 && newOwnerId > 0 && areTeammates(oldOwnerId, newOwnerId)) return;

      if (oldOwnerId > 0) {
        const oldF = State.factions[oldOwnerId];
        if (oldF) {
          oldF.pixelsCount--;
          oldF.sumX -= x;
          oldF.sumY -= y;
          if (oldF.pixelsCount <= 0) {
            oldF.pixelsCount = 0;
            oldF.alive = false;
            // If the human player just lost all of their land during battle, trigger GAME OVER!
            if (oldF.isHuman && State.mode === 'battle') {
              const totalSlots = Math.max(2, State.factions.length - 1);
              const aliveCompetitors = State.factions.slice(2).filter(f => f && f.alive && f.pixelsCount > 0).length;
              State.humanEliminatedRank = Math.min(totalSlots, Math.max(2, aliveCompetitors + 1));
              setTimeout(() => {
                if (State.mode === 'battle') finishMatchAndAwardStars(true);
              }, 60);
            }
          }
        }
      }

      mapOwner[idx] = newOwnerId;

      if (newOwnerId > 0) {
        const newF = State.factions[newOwnerId];
        if (newF) {
          newF.pixelsCount++;
          newF.sumX += x;
          newF.sumY += y;
          if (x < newF.minX) newF.minX = x;
          if (x > newF.maxX) newF.maxX = x;
          if (y < newF.minY) newF.minY = y;
          if (y > newF.maxY) newF.maxY = y;
        }
