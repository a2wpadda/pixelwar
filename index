    function stampSpawnCircle(factionId, cx, cy, offsets) {
      const f = State.factions[factionId];
      if (!f) return;
      // Snap spawn to nearest land tile if needed
      let bestX = Math.max(2, Math.min(MAP_W - 3, Math.round(cx)));
      let bestY = Math.max(2, Math.min(MAP_H - 3, Math.round(cy)));
      if (mapTerrain[bestY * MAP_W + bestX] < 2) {
        outer: for (let r = 1; r <= 65; r++) {
          for (let dy = -r; dy <= r; dy++) {
            for (let dx = -r; dx <= r; dx++) {
              const nx = bestX + dx, ny = bestY + dy;
              if (nx >= 2 && nx < MAP_W - 2 && ny >= 2 && ny < MAP_H - 2 && mapTerrain[ny * MAP_W + nx] >= 2 && mapOwner[ny * MAP_W + nx] === 0) {
                bestX = nx; bestY = ny;
                break outer;
              }
            }
          }
        }
      }
      f.capital = { x: bestX, y: bestY };
      for (const off of offsets) {
        const nx = bestX + off.dx;
        const ny = bestY + off.dy;
        if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H) {
          if (mapTerrain[ny * MAP_W + nx] >= 2) {
