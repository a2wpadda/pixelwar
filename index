      const realUsers = new Set([...(State.friends || [])]);
      try {
        if (typeof PixelWarSync !== 'undefined' && typeof PixelWarSync.getState === 'function') {
          const st = PixelWarSync.getState();
          if (st && st.accounts) {
            Object.values(st.accounts).forEach(acc => {
              if (acc && acc.username && acc.online) {
                realUsers.add(acc.username);
              }
            });
          }
        }
      } catch (e) {}
      realUsers.delete(State.commanderName);
      return Array.from(realUsers);
