      background: #131e36;
      border: 2px solid #233557;
      border-radius: 0;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .online-user-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #f8fafc;
    }

    .friend-star-badge {
      font-family: var(--font-pixel-display);
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      background: #292014;
      color: #fbbf24;
      border: 2px solid #fbbf24;
      padding: 2px 6px;
      border-radius: 0;
    }

    .btn-small-invite {
      font-family: var(--font-pixel-display);
      background: #0284c7;
      border: 2px solid #7dd3fc;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 6px 10px;
      border-radius: 0;
      cursor: pointer;
      box-shadow: 0 3px 0 #075985;
    }

    .btn-small-invite:hover {
      background: #0369a1;
    }

    .online-dot {
      width: 8px;
      height: 8px;
      border-radius: 0;
      background: #10b981;
      border: 1px solid #6ee7b7;
      display: inline-block;
    }

    /* =========================================================================
       3. IN-GAME HUD LAYER & PIXELATED 12-SLOT BOTTOM BAR
       ========================================================================= */
    #hud-layer {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
      padding: 14px 18px;
      z-index: 40;
    }

    .ingame-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      width: 100%;
    }

    .top-left-controls {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-hud-small {
      font-family: var(--font-pixel-display);
      background: #0d1526;
      border: 2px solid #2b426b;
      color: #e2e8f0;
      font-size: 11px;
      font-weight: 700;
      padding: 8px 12px;
      border-radius: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 3px 0 #050811;
    }

    .btn-hud-small:hover {
      background: #1e293b;
      border-color: #38bdf8;
      transform: translateY(1px);
      box-shadow: 0 2px 0 #050811;
    }

    .countdown-pill {
      font-family: var(--font-pixel-display);
      background: #0d1526;
      border: 3px solid #38bdf8;
      border-radius: 0;
      padding: 8px 18px;
      font-size: 11.5px;
      font-weight: 700;
      color: #fff;
      box-shadow: 4px 4px 0 #050811;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .countdown-pill.active-war {
      border-color: #f59e0b;
    }

    .btn-skip-spawn {
      font-family: var(--font-pixel-display);
      background: #f59e0b;
      color: #090d16;
      border: 2px solid #fef08a;
      border-radius: 0;
      padding: 4px 10px;
      font-size: 10px;
      font-weight: 700;
      cursor: pointer;
      display: none;
      box-shadow: 0 2px 0 #92400e;
    }

    .ingame-leaderboard {
      width: 230px;
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 10px 12px;
      box-shadow: 4px 4px 0 #050811;
    }

    .lb-header {
      font-family: var(--font-pixel-display);
      font-size: 9.5px;
      font-weight: 700;
      text-transform: uppercase;
      color: #94a3b8;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      padding-bottom: 4px;
      border-bottom: 2px solid #1e2f4d;
      display: flex;
      justify-content: space-between;
    }

    .lb-entry {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      padding: 3px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .lb-dot {
      width: 8px;
      height: 8px;
      border-radius: 0;
      margin-right: 6px;
      display: inline-block;
    }

    .territory-tooltip {
      position: absolute;
      bottom: 92px;
      right: 20px;
      width: 265px;
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 12px 14px;
      box-shadow: 4px 4px 0 #050811;
      pointer-events: none;
      display: none;
    }

    .tooltip-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .tooltip-name {
      font-family: var(--font-pixel-display);
      font-size: 12.5px;
      font-weight: 700;
      color: #fff;
    }

    .tooltip-type {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .tooltip-meta-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #cbd5e1;
      margin-bottom: 4px;
    }

    .tooltip-action-hint {
      margin-top: 8px;
      font-size: 11.5px;
      color: #fbbf24;
      font-weight: 700;
      border-top: 2px solid #1f2f4e;
      padding-top: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Pixelated Single-Row Bottom Game Dock */
    .bottom-dock-wrapper {
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: auto;
      max-width: 98vw;
    }

    .build-info-banner {
      background: #0d1526;
      border: 3px solid #38bdf8;
      border-radius: 0;
      padding: 7px 14px;
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      width: 100%;
      max-width: 780px;
      box-shadow: 4px 4px 0 #050811;
    }

    .ingame-bottom-dock {
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 8px 14px;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 14px;
      box-shadow: 5px 5px 0 #050811, inset 0 2px 0 rgba(255, 255, 255, 0.08);
      overflow-x: auto;
      max-width: 98vw;
    }

    .dock-top-stats-row {
      display: flex;
      align-items: center;
      gap: 14px;
      border-right: 2px solid #233047;
      padding-right: 14px;
      flex-shrink: 0;
    }

    .dock-player-col {
      display: flex;
      align-items: center;
      gap: 9px;
      padding-right: 14px;
      border-right: 2px solid #233047;
    }

    .player-color-box {
      width: 12px;
      height: 12px;
      border-radius: 0;
      border: 2px solid #fff;
      background: #0ea5e9;
    }

    .player-name-text {
      font-family: var(--font-pixel-display);
      font-size: 12px;
      font-weight: 700;
      color: #f8fafc;
      line-height: 1.15;
    }

    .player-share-text {
      font-size: 11px;
      color: #94a3b8;
      margin-top: 2px;
    }

    .dock-stat-col {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 122px;
      padding-right: 14px;
      border-right: 2px solid #233047;
    }

    .dock-stat-col.gold-col {
      min-width: 98px;
      border-right: none;
      padding-right: 0;
    }

    .dock-label-row {
      font-family: var(--font-pixel-display);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 9.5px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .dock-rate-text {
      color: #f97316;
      font-weight: 700;
    }

    .dock-val-large {
      font-family: var(--font-pixel-display);
      font-size: 13.5px;
      font-weight: 700;
      color: #f8fafc;
    }

    .dock-progress-bar {
      width: 100%;
      height: 5px;
      background: #080d18;
      border: 1px solid #283c60;
      border-radius: 0;
      overflow: hidden;
      margin-top: 2px;
    }

    .dock-progress-fill {
      height: 100%;
      background: #0ea5e9;
      width: 45%;
      transition: width 0.2s;
    }

    .dock-attack-col {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-right: 14px;
      border-right: 2px solid #233047;
    }

    .dock-pct-buttons {
      display: flex;
      background: #080d18;
      border: 2px solid #28364f;
      border-radius: 0;
      padding: 2px;
      gap: 2px;
    }

    .btn-dock-pct {
      font-family: var(--font-pixel-display);
      background: transparent;
      border: none;
      color: #cbd5e1;
      font-size: 9.5px;
      font-weight: 700;
      padding: 3px 6px;
      border-radius: 0;
      cursor: pointer;
    }

    .btn-dock-pct:hover, .btn-dock-pct.active {
      background: #f59e0b;
      color: #090d16;
    }

    .dock-attack-subtext {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
    }

    /* 12 Compact Pixel Square Hotbar Slots */
    .dock-hotbar-slots {
      display: flex;
      align-items: center;
      gap: 5px;
      flex-shrink: 0;
    }

    .hotbar-slot {
      position: relative;
      width: 46px;
      height: 48px;
      background: #152036;
      border: 2px solid #2d4269;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      box-shadow: 0 3px 0 #060a12, inset 0 1px 0 rgba(255,255,255,0.1);
      transition: transform 0.08s, border-color 0.08s;
      padding: 4px 2px 3px 2px;
      user-select: none;
    }

    .hotbar-slot:hover {
      background: #1e2e4d;
      border-color: #38bdf8;
      transform: translateY(1px);
      box-shadow: 0 2px 0 #060a12;
    }

    .hotbar-slot.selected-slot {
      background: #263859;
      border-color: #fbbf24;
      box-shadow: 0 0 0 1px #fbbf24, 0 3px 0 #92400e;
    }

    .slot-key {
      font-family: var(--font-pixel-display);
      position: absolute;
      top: 2px;
      left: 3px;
      font-size: 8px;
      font-weight: 700;
      color: #64748b;
      line-height: 1;
    }

    .slot-cost {
      font-family: var(--font-pixel-display);
      font-size: 8.5px;
      font-weight: 700;
      color: #ef4444;
      line-height: 1;
    }

    .slot-cost.can-afford {
      color: #fbbf24;
    }
  </style>
</head>
<body>

  <div id="app-container">
    <canvas id="game-canvas"></canvas>

    <!-- =========================================================================
         1. MANDATORY SINGLE-BUTTON LOGIN OVERLAY (Username + Password + GO)
         ========================================================================= -->
    <div id="auth-gate-overlay">
      <div class="auth-card">
        <div class="auth-logo-badge">
          <svg class="svg-icon" viewBox="0 0 24 24" style="width:28px; height:28px; fill:none; stroke:#fff; stroke-width:2.2;">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 3v18M3 12h18"/>
            <circle cx="12" cy="12" r="4" style="stroke:#fbbf24; fill:rgba(251,191,36,0.3);"/>
          </svg>
        </div>
        <h2 class="auth-title">PIXEL WAR</h2>
        <p class="auth-sub">Enter your Username and Password, then press GO.<br>New usernames are registered automatically.</p>

        <div class="auth-form">
          <input type="text" class="auth-input" id="auth-username" placeholder="Username" maxlength="16" autocomplete="off">
          <input type="password" class="auth-input" id="auth-password" placeholder="Password">

          <div class="auth-error-box" id="auth-error-box"></div>

          <button class="btn-auth-go" id="btn-auth-go">
            <span id="btn-auth-go-label">GO</span>
            <svg viewBox="0 0 24 24" style="width:20px; height:20px; fill:#111827;">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- =========================================================================
       2. MAIN MENU LAYER (RoWorld Layout)
       ========================================================================= -->
    <div id="menu-layer">
      <div class="menu-top-header">
        <div class="title-wrapper">
          <div class="logo-badge">
            <svg class="svg-icon" viewBox="0 0 24 24" style="width:24px; height:24px; fill:none; stroke:#fff; stroke-width:2.2;">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 3v18M3 12h18"/>
              <circle cx="12" cy="12" r="4" style="stroke:#fbbf24; fill:rgba(251,191,36,0.3);"/>
            </svg>
          </div>
          <h1 class="game-logo-title">PIXEL WAR</h1>
          <div class="game-logo-sub">CONQUER THE REAL WORLD</div>
        </div>

        <div class="menu-top-right interactive">
          <div class="top-badges-row">
            <!-- CUSTOMIZE BUTTON NEXT TO STARS & DIAMONDS -->
            <button class="btn-customize-top" id="btn-open-customize" title="Customize Territory Color &amp; Pixel Pattern">
              <svg viewBox="0 0 24 24" style="width:14px; height:14px; fill:#ffffff;">
                <rect x="3" y="3" width="8" height="8"/>
                <rect x="13" y="3" width="8" height="8" fill="#fbbf24"/>
                <rect x="3" y="13" width="8" height="8" fill="#38bdf8"/>
                <rect x="13" y="13" width="8" height="8"/>
              </svg>
              <span>CUSTOMIZE</span>
            </button>
            <div class="stat-pill pill-gold" title="Stars earned from match placement (up to 5,000 for 1st place)">
              <svg class="svg-icon" viewBox="0 0 24 24" style="width:14px; height:14px; fill:#fbbf24;">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <span id="menu-stars-val">0</span>
            </div>
            <div class="stat-pill pill-gems" title="Diamonds (+5 Diamonds for every 1st Place Victory)">
              <svg class="svg-icon" viewBox="0 0 24 24" style="width:14px; height:14px; fill:#34d399;">
                <polygon points="6 3 18 3 22 9 12 22 2 9"/>
              </svg>
              <span id="menu-diamonds-val">0</span>
            </div>
          </div>

          <!-- GIANT SHOP BUTTON (Crate System) -->
          <div class="btn-giant-shop" id="btn-open-shop">
            <div>
              <div class="giant-shop-title">SHOP</div>
              <div class="giant-shop-sub">BASIC / RARE / LEGENDARY CRATES</div>
            </div>
            <svg viewBox="0 0 24 24" style="width:32px; height:32px; fill:#090d16;">
              <path d="M21 8l-9-5-9 5v8l9 5 9-5V8zm-9-2.8L17.8 8 12 10.8 6.2 8 12 5.2zM5 9.8l6 3v6.4l-6-3.3V9.8zm8 9.4v-6.4l6-3v6.1l-6 3.3z"/>
            </svg>
          </div>

          <!-- UPGRADES BUTTON DIRECTLY UNDER SHOP -->
          <div class="btn-giant-upgrades" id="btn-open-upgrades">
            <div>
              <div class="giant-upgrades-title">UPGRADES</div>
              <div class="giant-upgrades-sub">DUPLICATE CARDS &amp; LEVEL UP</div>
            </div>
            <svg viewBox="0 0 24 24" style="width:26px; height:26px; fill:#ffffff;">
              <polygon points="12,3 4,11 9,11 9,21 15,21 15,11 20,11"/>
            </svg>
          </div>

          <!-- LOADOUTS BUTTON DIRECTLY UNDER UPGRADES -->
          <div class="btn-giant-loadouts" id="btn-open-loadouts">
            <div>
              <div class="giant-loadouts-title">LOADOUTS</div>
              <div class="giant-loadouts-sub">EQUIP 12 TOWERS &amp; BOATS</div>
            </div>
            <svg viewBox="0 0 24 24" style="width:26px; height:26px; fill:#ffffff;">
              <rect x="3" y="4" width="7" height="7"/>
              <rect x="14" y="4" width="7" height="7"/>
              <rect x="3" y="13" width="7" height="7"/>
              <rect x="14" y="13" width="7" height="7"/>
            </svg>
          </div>

          <!-- INDEX BUTTON DIRECTLY UNDER LOADOUTS (ENCYCLOPEDIA OF EVERYTHING) -->
          <div class="btn-giant-index" id="btn-open-index">
            <div>
              <div class="giant-index-title">INDEX</div>
              <div class="giant-index-sub">ALL ITEMS, COLORS &amp; PATTERNS</div>
            </div>
            <svg viewBox="0 0 24 24" style="width:26px; height:26px; fill:#ffffff;">
              <path d="M4 4h7v16H4V4zm9 0h7v16h-7V4zm-7 3v2h3V7H6zm0 4v2h3v-2H6zm9-4v2h3V7h-3zm0 4v2h3v-2h-3z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Left Sidebar: Invites Box Directly Above Party Box -->
      <div class="menu-left-sidebar interactive">
        <!-- Invites Card Above Party -->
        <div class="menu-invites-card">
          <div class="party-card-title">
            <div style="display:flex; align-items:center; gap:8px;">
              <svg class="svg-icon" viewBox="0 0 24 24" style="fill:#fbbf24; width:16px; height:16px;">
                <path d="M4 4h16v16H4V4zm2 4l6 4 6-4V6l-6 4-6-4v2z"/>
              </svg>
              <span>Invites</span>
            </div>
            <span id="invites-count-badge" style="font-size:10px; color:#fbbf24; background:#1e293b; border:1px solid #475569; padding:2px 6px;">0 PENDING</span>
          </div>
          <div class="invites-list-box" id="incoming-invites-list">
            <div style="font-size:11.5px; color:#64748b; padding:6px 8px; background:#09101d; border:2px dashed #1e2f4d; text-align:center;">
              No pending party invites right now.
            </div>
          </div>
        </div>

        <!-- Party & Saved Friends Card -->
        <div class="menu-party-card">
          <div class="party-card-title">
            <div style="display:flex; align-items:center; gap:8px;">
              <svg class="svg-icon" viewBox="0 0 24 24" style="fill:#38bdf8; width:16px; height:16px;">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="8.5" cy="7" r="4"/>
                <line x1="20" y1="8" x2="20" y2="14"/>
                <line x1="23" y1="11" x2="17" y2="11"/>
              </svg>
              <span>Party</span>
            </div>
            <span id="party-code-tag" style="font-size:11px; color:#38bdf8; display:none;">#PW-409</span>
          </div>
          <p class="party-card-desc">
            Invite online friends or players to your party. Friends appear at the top with priority!
          </p>
          <div class="party-member-list" id="party-member-list"></div>
          <div class="party-btn-row">
            <button class="btn-party-action" id="btn-party-invite">
              <svg class="svg-icon" viewBox="0 0 24 24" style="fill:#cbd5e1; width:14px; height:14px;">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="8.5" cy="7" r="4"/>
              </svg>
              <span id="btn-party-invite-text">Invite</span>
            </button>
            <button class="btn-party-action btn-party-friends" id="btn-open-friends">
              <svg class="svg-icon" viewBox="0 0 24 24" style="fill:currentColor; width:14px; height:14px;">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              <span>Friends</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Center Bottom Play & Lobby Card -->
      <div class="menu-center-bottom interactive">
        <div class="match-panel">
          <div class="user-welcome-bar">
            <span id="welcome-user-text">Welcome, Commander</span>
            <button class="btn-signout-trigger" id="btn-signout">Switch Account / Sign Out</button>
          </div>

          <div class="play-solo-container">
            <button class="btn-play-orange" id="btn-play-solo">
              <svg viewBox="0 0 24 24" style="width:20px; height:20px; fill:#111827;">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
              <span id="btn-play-main-text">Play Solo</span>
            </button>
            <button class="btn-help-how" id="btn-open-howto" title="How to Play">
              <svg class="svg-icon" viewBox="0 0 24 24" style="width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2.2;">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                <line x1="12" y1="17" x2="12.01" y2="17" stroke-width="3" stroke-linecap="round"/>
              </svg>
              <span>How to Play</span>
            </button>
          </div>

          <div class="matches-header" id="public-queues-header">Public Queues (1m Server Rotation • Max 25 Players)</div>

          <div class="match-item-row">
            <div class="match-info-left">
              <div class="match-icon-box">
                <svg class="svg-icon" viewBox="0 0 24 24" style="fill:#38bdf8;">
                  <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                  <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" fill="none" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="match-text-title" id="queue-title-countries">Countries</div>
                <div class="match-text-meta" id="public-mm-sub-1">Single Country Map • New Server Every 1m • Max 25</div>
              </div>
            </div>
            <button class="btn-queue-join" data-join-queue="countries">Join</button>
          </div>

          <div class="match-item-row">
            <div class="match-info-left">
