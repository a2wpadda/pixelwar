    function joinPublicQueueLobby(queueType) {
      if (State.mode !== 'menu') return;
      const rot = getCurrentQueueRotation();
      const mapSpec = getMapSpecForQueue(queueType, rot.epochMinute);

      State.activeLobbyQueue = queueType;
      State.activeLobbyEpoch = rot.epochMinute;
      State.activeMapSpec = mapSpec;
      State.rtdbSnapshots = [];

      // Slide all menu panels off-screen in their respective directions!
      const menuLayer = document.getElementById('menu-layer');
      menuLayer.classList.add('lobby-joined-active');

      const loadingView = document.getElementById('lobby-loading-view');
      const joinedView = document.getElementById('lobby-joined-view');
      if (loadingView) loadingView.style.display = 'flex';
      if (joinedView) joinedView.style.display = 'none';

      const qTitle = document.getElementById('lobby-queue-title');
      const qSub = document.getElementById('lobby-map-subtitle');
      if (queueType === 'countries') {
        if (qTitle) qTitle.textContent = `COUNTRIES — ${mapSpec.name.toUpperCase()}`;
        if (qSub) qSub.textContent = `Single-Country Map: ${mapSpec.name} • Rotates Every 1 Minute • Max 25 Players`;
      } else if (queueType === 'blitz_teams') {
        if (qTitle) qTitle.textContent = `BLITZ TEAMS — ${mapSpec.name.toUpperCase()}`;
        if (qSub) qSub.textContent = `Single-Continent Team War: ${mapSpec.name} (Blue vs Red) • Max 25 Players`;
      } else {
        if (qTitle) qTitle.textContent = `WORLD SERVER — FULL EARTH`;
        if (qSub) qSub.textContent = `Full World Map • Refreshes Every 1 Minute • Max 25 Players`;
      }

      syncLocalAndCloudLobbyPlayers();
      updatePublicQueueRotationUI();

      // Connect to Firebase Realtime Database Lobby
      if (rtdbInstance && State.commanderName) {
        try {
          const cleanId = State.commanderName.toLowerCase().replace(/[^a-z0-9_]/g, '') || 'commander';
          const lobbyPath = `pixelwar_lobbies/${queueType}_${rot.epochMinute}/players`;
          activeRtdbLobbyRef = rtdbInstance.ref(lobbyPath);
          activeRtdbPlayerRef = activeRtdbLobbyRef.child(cleanId);
          activeRtdbPlayerRef.set({
            name: State.commanderName,
            level: Math.max(1, State.playerLevel || 1),
            joinedAt: Date.now()
          }).catch(() => {});
          if (activeRtdbPlayerRef.onDisconnect) {
            activeRtdbPlayerRef.onDisconnect().remove().catch(() => {});
          }
          activeRtdbLobbyRef.on('value', snap => {
            const val = snap.val();
            if (val && typeof val === 'object') {
              State.rtdbSnapshots = Object.values(val);
              syncLocalAndCloudLobbyPlayers();
            }
          });
        } catch (e) {}
      }

      if (lobbyJoinTimeout) clearTimeout(lobbyJoinTimeout);
      lobbyJoinTimeout = setTimeout(() => {
        if (!State.activeLobbyQueue) return;
        if (loadingView) loadingView.style.display = 'none';
        if (joinedView) joinedView.style.display = 'flex';
        syncLocalAndCloudLobbyPlayers();
      }, 380);
    }

    function detachLobbyListeners() {
      if (lobbyJoinTimeout) {
        clearTimeout(lobbyJoinTimeout);
        lobbyJoinTimeout = null;
      }
      if (activeRtdbPlayerRef) {
        try { activeRtdbPlayerRef.remove().catch(() => {}); } catch (e) {}
        activeRtdbPlayerRef = null;
      }
      if (activeRtdbLobbyRef) {
        try { activeRtdbLobbyRef.off(); } catch (e) {}
        activeRtdbLobbyRef = null;
      }
      if (State.activeLobbyQueue && State.activeLobbyEpoch && State.commanderName) {
        const storageKey = getLobbyStorageKey(State.activeLobbyQueue, State.activeLobbyEpoch);
        try {
          const raw = localStorage.getItem(storageKey);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              const filtered = parsed.filter(p => {
                const n = typeof p === 'string' ? p : p?.name;
                return n && n.toLowerCase() !== State.commanderName.toLowerCase();
              });
              localStorage.setItem(storageKey, JSON.stringify(filtered));
            }
          }
        } catch (e) {}
      }
    }

    function leavePublicQueueLobby() {
      detachLobbyListeners();
      State.activeLobbyQueue = null;
      State.activeLobbyEpoch = null;
      State.activeLobbyPlayers = [];
      const menuLayer = document.getElementById('menu-layer');
      if (menuLayer) menuLayer.classList.remove('lobby-joined-active');
    }

    function launchFromPublicLobby() {
      if (!State.activeLobbyQueue) return;
      const qType = State.activeLobbyQueue;
      const mSpec = State.activeMapSpec || getMapSpecForQueue(qType, State.activeLobbyEpoch || Math.floor(Date.now() / 60000));
      const players = [...(State.activeLobbyPlayers || [])];
      const epoch = State.activeLobbyEpoch || Math.floor(Date.now() / 60000);

      detachLobbyListeners();
      State.activeLobbyQueue = null;
      State.activeLobbyEpoch = null;
      const menuLayer = document.getElementById('menu-layer');
      if (menuLayer) menuLayer.classList.remove('lobby-joined-active');

      State.activeMatchId = `${qType}_${epoch}`;
      startMatch(qType, mSpec, players, true);
    }

    function finishMatchAndAwardStars(isEliminated = false) {
      if (State.mode === 'gameover') return;
      State.mode = 'gameover';

      const totalContenders = Math.max(2, State.factions.length - 1);
      // Rank all contenders by territory pixel count
      const ranked = State.factions.slice(1).slice().sort((a, b) => (b?.pixelsCount || 0) - (a?.pixelsCount || 0));
      const idx = ranked.findIndex(f => f && f.isHuman);
      const place = isEliminated
        ? (State.humanEliminatedRank || totalContenders)
        : (idx >= 0 ? (idx + 1) : totalContenders);
      const isWin = !isEliminated && place === 1;
      const starsEarned = Math.max(100, (51 - Math.min(50, place)) * 100);
      const diamondsEarned = isWin ? 5 : 0;

      // Record Wins & Losses
      if (isWin) {
        State.wins = (State.wins || 0) + 1;
      } else {
        State.losses = (State.losses || 0) + 1;
      }

      // Experience (XP) & Player Leveling based on match placement
      const xpEarned = Math.max(50, (51 - Math.min(50, place)) * 25 + (isWin ? 250 : 0));
      const prevLevel = Math.max(1, State.playerLevel || 1);
      State.xp = (State.xp || 0) + xpEarned;
      State.playerLevel = prevLevel;
      while (State.xp >= getRequiredXPForLevel(State.playerLevel)) {
        State.xp -= getRequiredXPForLevel(State.playerLevel);
        State.playerLevel++;
      }
      const leveledUp = State.playerLevel > prevLevel;

      State.stars = (State.stars || 0) + starsEarned;
      State.diamonds = (State.diamonds || 0) + diamondsEarned;
      saveAccountData();
      refreshAccountUI();

      const rTitle = document.getElementById('results-title');
      if (isEliminated) {
        rTitle.textContent = 'GAME OVER';
        rTitle.style.color = '#f43f5e';
      } else if (place === 1) {
        rTitle.textContent = 'VICTORY — CONQUEROR!';
        rTitle.style.color = '#10b981';
      } else {
        rTitle.textContent = 'MATCH COMPLETE';
        rTitle.style.color = '#ffffff';
      }
      const modeLabel = State.isPublicServerMatch ? `${totalContenders} Players` : `${totalContenders} Countries`;
      document.getElementById('results-place-text').textContent = isEliminated
        ? `Your territory was conquered! You placed #${place} out of ${modeLabel}.`
        : `You placed #${place} out of ${modeLabel}!`;
      document.getElementById('results-stars-earned').textContent = `+${starsEarned.toLocaleString()} Stars Earned`;

      const xpEl = document.getElementById('results-xp-earned');
      if (xpEl) {
        const needNext = Math.max(0, getRequiredXPForLevel(State.playerLevel) - State.xp);
        xpEl.textContent = leveledUp
          ? `+${xpEarned.toLocaleString()} XP Earned — LEVEL UP TO LEVEL ${State.playerLevel}!`
          : `+${xpEarned.toLocaleString()} XP Earned • Level ${State.playerLevel} (Need ${needNext.toLocaleString()} XP)`;
      }

      const dEl = document.getElementById('results-diamonds-earned');
      if (diamondsEarned > 0) {
        dEl.style.display = 'block';
        dEl.style.color = '#67e8f9';
        dEl.textContent = `+${diamondsEarned} Diamonds Earned (1st Place Bonus!)`;
      } else {
        dEl.style.display = 'block';
        dEl.style.color = '#94a3b8';
        dEl.textContent = `Win 1st Place (#1) to earn +5 Diamonds!`;
      }
      document.getElementById('modal-results').style.display = 'flex';
    }

