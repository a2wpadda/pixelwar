    function rollShopCrate(cCat, tIdx) {
      if (State.isRollingCrate) return;
      const crateObj = (SHOP_CRATES_BY_CAT[cCat] || [])[tIdx];
      if (!crateObj) return;
      const banner = document.getElementById('crate-reward-banner');

      if (crateObj.costType === 'stars') {
        if (State.stars < crateObj.cost) {
          banner.style.display = 'block';
          banner.style.borderColor = '#f43f5e';
          banner.style.color = '#fda4af';
          banner.textContent = `Not enough Stars! Need ${crateObj.cost.toLocaleString()} Stars (Play matches to earn up to 5,000 Stars).`;
          return;
        }
        State.stars -= crateObj.cost;
      } else {
        if (State.diamonds < crateObj.cost) {
          banner.style.display = 'block';
          banner.style.borderColor = '#f43f5e';
          banner.style.color = '#fda4af';
          banner.textContent = `Not enough Diamonds! Win 1st place (#1/50) to earn +5 Diamonds.`;
          return;
        }
        State.diamonds -= crateObj.cost;
      }

      refreshAccountUI();
      saveAccountData();

      // Build candidate pool for this crate
      let pool = [];
      if (cCat === 'Customize') {
        pool = crateObj.customType === 'color' ? CUSTOM_COLORS : CUSTOM_PATTERNS;
      } else {
        pool = ALL_ITEMS.filter(it => it.cat === cCat);
      }

      const TOTAL_CARDS = 34;
      const WIN_INDEX = 28;
      const reelEntries = [];
      for (let i = 0; i < TOTAL_CARDS; i++) {
        reelEntries.push(pickWeightedPoolEntry(pool, crateObj.weights));
      }
      const winner = reelEntries[WIN_INDEX];

      const overlay = document.getElementById('fullscreen-roller-overlay');
      const track = document.getElementById('roller-track');
      const viewport = document.getElementById('roller-viewport');
      const titleTxt = document.getElementById('roller-title-text');
      const subTxt = document.getElementById('roller-sub-text');
      const resultPanel = document.getElementById('roller-result-panel');
      const resultHeadline = document.getElementById('roller-result-headline');
      const resultDetail = document.getElementById('roller-result-detail');

      overlay.style.display = 'flex';
      resultPanel.style.display = 'none';
      banner.style.display = 'none';
      titleTxt.textContent = `ROLLING ${crateObj.title.toUpperCase()}...`;
      subTxt.textContent = `DECELERATING PIXEL REEL`;

      track.innerHTML = reelEntries.map((entry, idx) => {
        let visual = '';
        if (cCat === 'Customize' && crateObj.customType === 'color') {
          visual = `<div style="width:44px; height:32px; background:${entry.fill}; border:3px solid ${entry.border};"></div>`;
        } else if (cCat === 'Customize' && crateObj.customType === 'pattern') {
          const previewUrl = createPatternPreviewDataURL(entry.id);
          visual = `<img src="${previewUrl}" style="width:48px; height:32px; border:2px solid #fff; image-rendering:pixelated;" alt="${entry.name}">`;
        } else {
          visual = `<svg viewBox="0 0 24 24" style="width:36px; height:36px;">${getItemIconSvg(entry)}</svg>`;
        }
        const rCol = entry.rarity === 'Legendary' ? '#fbbf24' : (entry.rarity === 'Rare' ? '#38bdf8' : '#94a3b8');
        return `
          <div class="roller-card rarity-${entry.rarity}" id="roller-card-${idx}">
            <div style="font-family:var(--font-pixel-display); font-size:9px; color:${rCol}; text-transform:uppercase;">${entry.rarity}</div>
            ${visual}
            <div style="font-family:var(--font-pixel-display); font-size:10px; color:#fff; line-height:1.15;">${entry.name}</div>
          </div>
        `;
      }).join('');

      State.isRollingCrate = true;
      track.style.transition = 'none';
      track.style.transform = `translateX(0px)`;

      // Force layout before starting smooth pixel deceleration
      void track.offsetWidth;

      const cardWidth = 128;
      const gap = 10;
      const stepPx = cardWidth + gap;
      const vpCenter = viewport.clientWidth / 2;
      const jitter = (Math.random() - 0.5) * 32;
      const targetOffset = Math.max(0, (WIN_INDEX * stepPx + 12 + cardWidth / 2) - vpCenter + jitter);

      track.style.transition = 'transform 2.4s cubic-bezier(0.12, 0.82, 0.18, 1)';
      track.style.transform = `translateX(-${Math.round(targetOffset)}px)`;

      setTimeout(() => {
        State.isRollingCrate = false;
        const winEl = document.getElementById(`roller-card-${WIN_INDEX}`);
        if (winEl) winEl.classList.add('winner-pulse');

        titleTxt.textContent = `LANDED ON: ${winner.name.toUpperCase()} (${winner.rarity.toUpperCase()})!`;
        subTxt.textContent = `ROLL COMPLETE`;

        let rewardText = '';
        if (cCat === 'Customize' && crateObj.customType === 'color') {
          const already = State.unlockedColors.includes(winner.id);
          if (!already) {
            State.unlockedColors.push(winner.id);
            State.equippedColor = winner.id;
            applyHumanCustomColor();
            rewardText = `NEW COLOR UNLOCKED & EQUIPPED: ${winner.name} (${winner.rarity})!`;
          } else {
            State.stars += 250;
            rewardText = `Rolled Duplicate Color: ${winner.name}! Converted into +250 Bonus Stars.`;
          }
        } else if (cCat === 'Customize' && crateObj.customType === 'pattern') {
          const already = State.unlockedPatterns.includes(winner.id);
          if (!already) {
            State.unlockedPatterns.push(winner.id);
            State.equippedPattern = winner.id;
            State.needsBufferSync = true;
            rewardText = `NEW PIXEL PATTERN UNLOCKED & EQUIPPED: ${winner.name} (${winner.rarity})!`;
          } else {
            State.stars += 300;
            rewardText = `Rolled Duplicate Pattern: ${winner.name}! Converted into +300 Bonus Stars.`;
          }
        } else {
          // Tower / Dock / Ship / Missile item roll
          if (!State.ownedItems[winner.id]) {
            State.ownedItems[winner.id] = { level: 1, cards: 0 };
            rewardText = `NEW ${winner.rarity.toUpperCase()} UNLOCKED: ${winner.name}! Equip it in LOADOUTS!`;
          } else {
            const addCards = crateObj.dupCards || 1;
            State.ownedItems[winner.id].cards = (State.ownedItems[winner.id].cards || 0) + addCards;
            const curCards = State.ownedItems[winner.id].cards;
            const needed = State.ownedItems[winner.id].level || 1;
            rewardText = `DUPLICATE ROLLED: ${winner.name}! +${addCards} Upgrade Card${addCards > 1 ? 's' : ''} (${curCards}/${needed} Cards — Level up in UPGRADES)!`;
          }
        }

        resultHeadline.textContent = `${winner.name} — ${winner.rarity} ${cCat === 'Customize' ? (crateObj.customType === 'color' ? 'Color' : 'Pattern') : winner.cat}`;
        resultDetail.textContent = rewardText;
        resultPanel.style.display = 'flex';

        banner.style.display = 'block';
        banner.style.borderColor = '#10b981';
        banner.style.color = '#6ee7b7';
        banner.textContent = rewardText;

        saveAccountData();
        refreshAccountUI();
        renderBuildHotbar();
      }, 2450);
    }

