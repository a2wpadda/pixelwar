    };

    let authInstance = null;
    let dbInstance = null;
    let rtdbInstance = null;
    try {
      if (typeof firebase !== 'undefined') {
        if (firebase.setLogLevel) firebase.setLogLevel('silent');
        firebase.initializeApp(firebaseConfig);
