    /* =========================================================================
       MENU SLIDE-OFF TRANSITION & 25-PLAYER REALTIME LOBBY SCREEN
       ========================================================================= */
    .title-wrapper,
    .menu-left-sidebar,
    .menu-top-right,
    .menu-center-bottom,
    .menu-profile-corner {
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
    }

    /* When joining a public server:
       - Top picture/logo goes UP off screen
       - Left party/invites goes LEFT off screen
       - Right shop/buttons go RIGHT & DOWN off screen
       - Bottom match panel & profile corner go DOWN off screen */
    #menu-layer.lobby-joined-active .title-wrapper {
      transform: translate(-50%, -180%);
      opacity: 0;
      pointer-events: none;
    }

    #menu-layer.lobby-joined-active .menu-left-sidebar {
      transform: translateX(-150%);
      opacity: 0;
      pointer-events: none;
    }

    #menu-layer.lobby-joined-active .menu-top-right {
      transform: translate(150%, 90%);
      opacity: 0;
      pointer-events: none;
    }

    #menu-layer.lobby-joined-active .menu-center-bottom {
      transform: translateY(160%);
      opacity: 0;
      pointer-events: none;
    }

    #menu-layer.lobby-joined-active .menu-profile-corner {
      transform: translateY(160%);
      opacity: 0;
      pointer-events: none;
    }

    .public-lobby-screen {
