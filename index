<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Pixel War</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3CradialGradient id='g' cx='50%25' cy='50%25' r='50%25'%3E%3Cstop offset='0%25' stop-color='%2338bdf8'/%3E%3Cstop offset='100%25' stop-color='%231e3a8a'/%3E%3C/radialGradient%3E%3C/defs%3E%3Ccircle cx='32' cy='32' r='29' fill='url(%23g)' stroke='%2360a5fa' stroke-width='4'/%3E%3Ccircle cx='32' cy='32' r='16' fill='none' stroke='%23ffffff' stroke-width='4.5'/%3E%3Cpath d='M32 14v36M14 32h36' stroke='%23ffffff' stroke-width='4.5'/%3E%3Ccircle cx='32' cy='32' r='7.5' fill='rgba(251,191,36,0.35)' stroke='%23fbbf24' stroke-width='4'/%3E%3C/svg%3E">

  <!-- Pixel Art Fonts for Authentic Pixel War UI -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">

  <!-- Firebase Compatibility SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>

  <style>
    :root {
      --bg-dark: #070d18;
      --card-bg: #111a2e;
      --card-border: #2c4268;
      --btn-orange: #ff9d00;
      --btn-orange-hover: #ffad1f;
      --btn-blue: #0284c7;
      --accent-cyan: #38bdf8;
      --accent-gold: #f59e0b;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --font-pixel-display: 'Silkscreen', 'Pixelify Sans', monospace;
      --font-pixel-body: 'Pixelify Sans', 'Silkscreen', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      font-family: var(--font-pixel-body);
      image-rendering: pixelated;
    }

    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #2c6693;
      color: var(--text-main);
    }

    #app-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    canvas#game-canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
      cursor: grab;
    }

    canvas#game-canvas:active {
      cursor: grabbing;
    }

    .svg-icon {
      display: inline-block;
      width: 18px;
      height: 18px;
      fill: currentColor;
      vertical-align: middle;
      shape-rendering: crispEdges;
    }

    svg {
      shape-rendering: crispEdges;
    }

    .interactive {
      pointer-events: auto;
    }

    /* =========================================================================
       1. MANDATORY SINGLE-STEP LOGIN GATE (Pixel Style)
       ========================================================================= */
    #auth-gate-overlay {
      position: absolute;
      inset: 0;
      background: rgba(6, 11, 22, 0.86);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .auth-card {
      width: 100%;
      max-width: 410px;
      background: #0d1526;
      border: 3px solid #38bdf8;
      border-radius: 0;
      padding: 28px 24px;
      box-shadow: 6px 6px 0 #04070e, inset 0 2px 0 rgba(255, 255, 255, 0.12);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .auth-logo-badge {
      width: 48px;
      height: 48px;
      background: #1e3a8a;
      border: 3px solid #38bdf8;
      border-radius: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 3px 3px 0 #04070e;
      margin-bottom: 12px;
    }

    .auth-title {
      font-family: var(--font-pixel-display);
      font-size: 28px;
      font-weight: 700;
      color: #fff9ea;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-shadow: 3px 3px 0 #04070e;
      margin-bottom: 6px;
    }

    .auth-sub {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.4;
    }

    .auth-form {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .auth-input {
      width: 100%;
      background: #080d18;
      border: 3px solid #283c60;
      padding: 12px 14px;
      border-radius: 0;
      color: #fff;
      font-family: var(--font-pixel-body);
      font-size: 15px;
      font-weight: 600;
      outline: none;
      box-shadow: inset 2px 2px 0 #04070e;
    }

    .auth-input:focus {
      border-color: var(--accent-cyan);
    }

    .auth-error-box {
      width: 100%;
      background: #3b0d15;
      border: 2px solid #ef4444;
      color: #fca5a5;
      font-size: 12px;
      font-weight: 700;
      padding: 10px 12px;
      border-radius: 0;
      display: none;
      text-align: center;
    }

    .btn-auth-go {
      width: 100%;
      height: 52px;
      background: #f59e0b;
      border: 3px solid #fde68a;
      border-radius: 0;
      color: #090d16;
      font-family: var(--font-pixel-display);
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      margin-top: 6px;
      box-shadow: 0 5px 0 #92400e, inset 0 2px 0 rgba(255, 255, 255, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: transform 0.08s, box-shadow 0.08s;
    }

    .btn-auth-go:hover {
      background: #fbbf24;
      transform: translateY(2px);
      box-shadow: 0 3px 0 #92400e, inset 0 2px 0 rgba(255, 255, 255, 0.55);
    }

    .btn-auth-go:active {
      transform: translateY(5px);
      box-shadow: 0 0 0 #92400e;
    }

    .btn-auth-go:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    /* =========================================================================
       2. MAIN MENU LAYER (Pixel Art UI Style)
       ========================================================================= */
    #menu-layer {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
      padding: 22px 28px;
      z-index: 50;
    }

    .menu-top-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      width: 100%;
    }

    .title-wrapper {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 18px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .logo-badge {
      width: 44px;
      height: 44px;
      background: #1e3a8a;
      border: 3px solid #38bdf8;
      border-radius: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 4px 4px 0 #060a12;
      margin-bottom: 6px;
    }

    .game-logo-title {
      font-family: var(--font-pixel-display);
      font-size: 56px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #fff9ea;
      text-transform: uppercase;
      text-shadow: 
        4px 4px 0 #0f172a,
        7px 7px 0 #050811;
      line-height: 1;
    }

    .game-logo-sub {
      font-family: var(--font-pixel-display);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      color: #38bdf8;
      background: #0d1526;
      border: 2px solid #283c60;
      padding: 3px 10px;
      text-transform: uppercase;
      margin-top: 8px;
      box-shadow: 3px 3px 0 #050811;
    }

    .menu-top-right {
      margin-left: auto;
      width: 288px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .top-badges-row {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .stat-pill {
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-pixel-display);
      font-size: 11.5px;
      font-weight: 700;
      box-shadow: 3px 3px 0 #050811;
      flex: 1;
    }

    .pill-gold {
      color: #fbbf24;
      border-color: #d97706;
    }

    .pill-gems {
      color: #34d399;
      border-color: #059669;
    }

    /* CUSTOMIZE BUTTON NEXT TO STARS & DIAMONDS */
    .btn-customize-top {
      background: #7c3aed;
      border: 3px solid #c4b5fd;
      border-radius: 0;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-pixel-display);
      font-size: 10.5px;
      font-weight: 700;
      color: #ffffff;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 0 3px 0 #4c1d95, 3px 3px 0 #050811;
      transition: transform 0.08s, background 0.08s;
      flex-shrink: 0;
    }

    .btn-customize-top:hover {
      background: #8b5cf6;
      transform: translateY(1px);
      box-shadow: 0 2px 0 #4c1d95, 2px 2px 0 #050811;
    }

    .btn-customize-top:active {
      transform: translateY(3px);
      box-shadow: none;
    }

    /* GIANT PIXEL SHOP, UPGRADES, LOADOUTS, AND INDEX BUTTONS (All extended flush to 100% width) */
    .btn-giant-shop {
      width: 100%;
      height: 62px;
      background: #f59e0b;
      border: 3px solid #fef08a;
      border-radius: 0;
      padding: 9px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: #090d16;
      box-shadow: 0 5px 0 #92400e, 5px 5px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.45);
      transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
    }

    .btn-giant-shop:hover {
      background: #fbbf24;
      transform: translateY(2px);
      box-shadow: 0 3px 0 #92400e, 3px 3px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.55);
    }

    .btn-giant-shop:active {
      transform: translateY(5px);
      box-shadow: 0 0 0 #92400e;
    }

    .giant-shop-title {
      font-family: var(--font-pixel-display);
      font-size: 21px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      line-height: 1;
    }

    .giant-shop-sub {
      font-family: var(--font-pixel-body);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      opacity: 0.9;
      margin-top: 3px;
    }

    /* UPGRADES BUTTON DIRECTLY UNDER SHOP */
    .btn-giant-upgrades {
      width: 100%;
      height: 50px;
      background: #0284c7;
      border: 3px solid #7dd3fc;
      border-radius: 0;
      padding: 7px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: #ffffff;
      box-shadow: 0 5px 0 #075985, 5px 5px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.3);
      transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
    }

    .btn-giant-upgrades:hover {
      background: #0ea5e9;
      transform: translateY(2px);
      box-shadow: 0 3px 0 #075985, 3px 3px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.4);
    }

    .btn-giant-upgrades:active {
      transform: translateY(5px);
      box-shadow: 0 0 0 #075985;
    }

    .giant-upgrades-title {
      font-family: var(--font-pixel-display);
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      line-height: 1;
      text-shadow: 2px 2px 0 #082f49;
    }

    .giant-upgrades-sub {
      font-family: var(--font-pixel-body);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #e0f2fe;
      margin-top: 2px;
    }

    /* LOADOUTS BUTTON DIRECTLY UNDER UPGRADES */
    .btn-giant-loadouts {
      width: 100%;
      height: 50px;
      background: #059669;
      border: 3px solid #6ee7b7;
      border-radius: 0;
      padding: 7px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: #ffffff;
      box-shadow: 0 5px 0 #065f46, 5px 5px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.3);
      transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
    }

    .btn-giant-loadouts:hover {
      background: #10b981;
      transform: translateY(2px);
      box-shadow: 0 3px 0 #065f46, 3px 3px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.4);
    }

    .btn-giant-loadouts:active {
      transform: translateY(5px);
      box-shadow: 0 0 0 #065f46;
    }

    .giant-loadouts-title {
      font-family: var(--font-pixel-display);
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      line-height: 1;
      text-shadow: 2px 2px 0 #064e3b;
    }

    .giant-loadouts-sub {
      font-family: var(--font-pixel-body);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #d1fae5;
      margin-top: 2px;
    }

    /* INDEX BUTTON DIRECTLY UNDER LOADOUTS */
    .btn-giant-index {
      width: 100%;
      height: 48px;
      background: #4f46e5;
      border: 3px solid #a5b4fc;
      border-radius: 0;
      padding: 7px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      color: #ffffff;
      box-shadow: 0 5px 0 #312e81, 5px 5px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.3);
      transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
    }

    .btn-giant-index:hover {
      background: #6366f1;
      transform: translateY(2px);
      box-shadow: 0 3px 0 #312e81, 3px 3px 0 #050811, inset 0 2px 0 rgba(255,255,255,0.4);
    }

    .btn-giant-index:active {
      transform: translateY(5px);
      box-shadow: 0 0 0 #312e81;
    }

    .giant-index-title {
      font-family: var(--font-pixel-display);
      font-size: 15.5px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      line-height: 1;
      text-shadow: 2px 2px 0 #1e1b4b;
    }

    .giant-index-sub {
      font-family: var(--font-pixel-body);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #e0e7ff;
      margin-top: 2px;
    }

    /* LEFT SIDEBAR: INVITES BOX ABOVE PARTY BOX */
    .menu-left-sidebar {
      width: 288px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-self: flex-start;
      margin-top: 8px;
    }

    .menu-invites-card {
      width: 100%;
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 12px 14px;
      box-shadow: 5px 5px 0 #050811, inset 0 2px 0 rgba(255, 255, 255, 0.07);
    }

    .invites-list-box {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 118px;
      overflow-y: auto;
    }

    .invite-pending-row {
      background: #132038;
      border: 2px solid #283c60;
      padding: 7px 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .btn-invite-accept {
      font-family: var(--font-pixel-display);
      font-size: 8.5px;
      font-weight: 700;
      background: #059669;
      border: 2px solid #6ee7b7;
      color: #ffffff;
      padding: 4px 7px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 0 2px 0 #064e3b;
    }

    .btn-invite-accept:hover {
      background: #10b981;
    }

    .btn-invite-decline {
      font-family: var(--font-pixel-display);
      font-size: 8.5px;
      font-weight: 700;
      background: #9f1239;
      border: 2px solid #fda4af;
      color: #ffffff;
      padding: 4px 7px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 0 2px 0 #4c0519;
    }

    .btn-invite-decline:hover {
      background: #e11d48;
    }

    .menu-party-card {
      width: 100%;
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 14px;
      box-shadow: 5px 5px 0 #050811, inset 0 2px 0 rgba(255, 255, 255, 0.07);
    }

    /* BOTTOM RIGHT CORNER: WINS, LOSSES & GIANT PLAYER LEVEL METER */
    .menu-profile-corner {
      position: absolute;
      right: 28px;
      bottom: 22px;
      width: 288px;
      background: #0d1526;
      border: 3px solid #2b426b;
      border-radius: 0;
      padding: 14px;
      box-shadow: 6px 6px 0 #050811, inset 0 2px 0 rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 55;
    }

    .profile-corner-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #1e2f4d;
      padding-bottom: 6px;
    }

    .profile-wl-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .profile-wl-box {
      background: #080d18;
      border: 2px solid #233557;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      box-shadow: inset 2px 2px 0 #04070e;
    }

    .profile-wl-label {
      font-family: var(--font-pixel-display);
      font-size: 9px;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .profile-wl-num {
      font-family: var(--font-pixel-display);
      font-size: 18px;
      font-weight: 700;
      margin-top: 3px;
    }

    .giant-level-meter {
      position: relative;
      width: 100%;
      height: 54px;
      background: #060a14;
      border: 3px solid #38bdf8;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 0 14px rgba(0, 0, 0, 0.95), 3px 3px 0 #04070e;
    }

    .giant-level-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0%;
      background: linear-gradient(90deg, #0369a1 0%, #0284c7 60%, #38bdf8 100%);
      border-right: 2px solid #bae6fd;
      transition: width 0.35s ease;
      z-index: 1;
    }

    .giant-level-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 2px;
      padding: 0 6px;
    }

    .giant-level-title {
      font-family: var(--font-pixel-display);
      font-size: 15px;
      font-weight: 700;
      color: #fbbf24;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 2px 2px 0 #04070e, -1px -1px 0 #04070e;
      line-height: 1.1;
    }

    .giant-level-xp-sub {
      font-family: var(--font-pixel-display);
      font-size: 8.5px;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 1px 1px 0 #04070e, -1px -1px 0 #04070e;
    }

    .party-card-title {
      font-family: var(--font-pixel-display);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 2px solid #1e2f4d;
    }

    .party-card-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.35;
      margin-bottom: 12px;
    }

    .party-member-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 10px;
    }

    .party-member-item {
      background: #142038;
      border: 2px solid #29406b;
      border-radius: 0;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .party-btn-row {
      display: flex;
      gap: 8px;
    }

    .btn-party-action {
      flex: 1;
      background: #1e293b;
