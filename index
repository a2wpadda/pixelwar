    /* =========================================================================
       MODALS (Pixel Art Frames & Scrollbars)
       ========================================================================= */
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(5, 10, 20, 0.85);
      z-index: 500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      pointer-events: auto;
    }

    .modal-card {
      width: 100%;
      max-width: 680px;
      max-height: 86vh;
      background: #0d1526;
      border: 3px solid #38bdf8;
      border-radius: 0;
      padding: 22px;
      box-shadow: 7px 7px 0 #04070e, inset 0 2px 0 rgba(255,255,255,0.1);
      display: flex;
      flex-direction: column;
      gap: 16px;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
