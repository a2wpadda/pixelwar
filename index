    function isPatternAltPixel(patternId, x, y) {
      switch (patternId) {
        case 'checker': return ((x + y) & 1) === 0;
        case 'stripes': return ((x + y) & 3) < 2;
        case 'scanline': return (y & 1) === 0;
        case 'vert_bars': return (x & 1) === 0;
        case 'dither_sparse': return ((x & 1) === 0) && ((y & 1) === 0);
        case 'dots': return (x % 3 === 0) && (y % 3 === 0);
        case 'cross': return (x % 4 === 0) || (y % 4 === 0);
        case 'big_checker': return (((x >> 1) + (y >> 1)) & 1) === 0;
        case 'brick_wall': return (y % 4 === 0) || (((x + ((y >> 2) & 1) * 3) % 6) === 0);
        case 'chevron_zag': {
          const zig = (x % 6) < 3 ? (x % 3) : (2 - (x % 3));
          return ((y + zig) % 4) < 2;
        }
        case 'plus_stitch': {
          const mx = x % 5, my = y % 5;
          return (mx === 2 && my >= 1 && my <= 3) || (my === 2 && mx >= 1 && mx <= 3);
        }
        case 'diamond': return ((x + y) % 4 === 0) || ((x - y + 1000) % 4 === 0);
        case 'camo': return (((x * 37 + y * 17) ^ (x >> 1)) & 3) === 0;
        case 'houndstooth': {
          const hx = x & 3, hy = y & 3;
          return (hx < 2 && hy < 2) || (hx === hy) || (hx === 3 && hy === 0);
        }
        case 'honeycomb': {
          const row = y % 6;
          const col = (x + (row >= 3 ? 2 : 0)) % 4;
          return row === 0 || row === 3 || col === 0;
        }
        case 'circuit_board': {
          const cx = x % 7, cy = y % 7;
          return (cx === 0 && cy < 5) || (cy === 0 && cx < 5) || (cx === 3 && cy === 3);
        }
        case 'star_matrix': {
          const sx = x % 6, sy = y % 6;
          return (sx === 3 && sy === 3) || (sx === 3 && (sy === 1 || sy === 5)) || (sy === 3 && (sx === 1 || sx === 5));
        }
        default: return false;
      }
    }

