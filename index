              </div>
            </div>
            <div>
              <div style="display:flex; justify-content:space-between; font-family:var(--font-pixel-display); font-size:9px; color:#cbd5e1; margin-bottom:3px;">
                <span>DUPLICATE CARDS (1→3→5→7)</span>
                <span style="color:${cards >= neededCards ? '#34d399' : '#fbbf24'};">${cards} / ${neededCards}</span>
              </div>
              <div class="card-meter-bar">
                <div class="card-meter-fill ${cards >= neededCards ? 'ready' : ''}" style="width:${pct}%;"></div>
              </div>
            </div>
            <button class="btn-buy-crate" data-upgrade-item="${item.id}" style="padding:7px 8px; font-size:9.5px; ${canUpgrade ? '' : 'background:#1e293b; border-color:#475569; color:#94a3b8; box-shadow:none;'}">
              ${cards >= neededCards ? `Upgrade Lv.${nextLvl} (${starCost} Stars)` : `Need ${neededCards - cards} More Card${neededCards - cards > 1 ? 's' : ''}`}
            </button>
          </div>
        `;
      }).join('');

      grid.querySelectorAll('[data-upgrade-item]').forEach(btn => {
        btn.addEventListener('click', () => {
          const itemId = btn.dataset.upgradeItem;
          const item = ALL_ITEMS.find(it => it.id === itemId);
          const st = State.ownedItems?.[itemId];
          if (!item || !st) return;
          const curLvl = st.level || 1;
          const nextLvl = curLvl + 2; // Goes up in twos: 1 -> 3 -> 5 -> 7
          const neededCards = curLvl;
          const starCost = neededCards * 400;
          const banner = document.getElementById('upgrades-notice-banner');

          if ((st.cards || 0) < neededCards) {
            banner.style.display = 'block';
            banner.style.borderColor = '#f43f5e';
            banner.style.color = '#fda4af';
            banner.textContent = `Need ${neededCards} Duplicate Cards for ${item.name}! Roll ${item.cat} Crates in the SHOP to get duplicate cards.`;
            return;
          }
          if (State.stars < starCost) {
            banner.style.display = 'block';
            banner.style.borderColor = '#f43f5e';
            banner.style.color = '#fda4af';
            banner.textContent = `Need ${starCost.toLocaleString()} Stars to upgrade ${item.name} to Lv.${nextLvl}!`;
            return;
          }

          State.stars -= starCost;
          st.cards -= neededCards;
          st.level = nextLvl;
          saveAccountData();
          refreshAccountUI();
          renderUpgradesModal();
          renderBuildHotbar();

          banner.style.display = 'block';
          banner.style.borderColor = '#10b981';
          banner.style.color = '#6ee7b7';
          banner.textContent = `UPGRADED ${item.name} from Lv.${curLvl} to Lv.${st.level} (+${(st.level - 1) * 25}% Power)!`;
        });
      });
    }

