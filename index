    /* =========================================================================
       PUBLIC QUEUES (Countries, World, Blitz Teams) + 1-MINUTE ROTATION + FIREBASE RTDB LOBBY (MAX 25)
       ========================================================================= */
    const MAX_LOBBY_PLAYERS = 25;
    let activeRtdbLobbyRef = null;
    let activeRtdbPlayerRef = null;
    let lobbyJoinTimeout = null;

    function getLobbyStorageKey(queueType, epochMinute) {
      return `pixelwar_rtdb_lobby_${queueType}_${epochMinute}`;
    }

    function getMapSpecForQueue(queueType, epochMinute = Math.floor(Date.now() / 60000)) {
      if (queueType === 'countries') {
        return ROTATING_COUNTRIES[epochMinute % ROTATING_COUNTRIES.length];
      }
      if (queueType === 'blitz_teams') {
        return ROTATING_CONTINENTS[epochMinute % ROTATING_CONTINENTS.length];
      }
      return { id: 'world', name: 'Full Earth' };
    }

    function updatePublicQueueRotationUI() {
      const rot = getCurrentQueueRotation();
      const pLvl = Math.max(1, State.playerLevel || 1);
      const bracketStr = getMatchmakingBracketLabel(pLvl);
      const secPad = String(rot.secsLeft).padStart(2, '0');

      const tCountries = document.getElementById('queue-title-countries');
      const tWorld = document.getElementById('queue-title-world');
      const tBlitz = document.getElementById('queue-title-blitz');
      if (tCountries) tCountries.textContent = `Countries — ${rot.countrySpec.name}`;
      if (tWorld) tWorld.textContent = `World — Full Earth`;
      if (tBlitz) tBlitz.textContent = `Blitz Teams — ${rot.continentSpec.name}`;

      const mm1 = document.getElementById('public-mm-sub-1');
      const mm2 = document.getElementById('public-mm-sub-2');
      const mm3 = document.getElementById('public-mm-sub-3');
      if (mm1) mm1.textContent = `Country: ${rot.countrySpec.name} • New Server in ${secPad}s • Max 25`;
      if (mm2) mm2.textContent = `Full World • Refreshes in ${secPad}s • ${bracketStr} • Max 25`;
      if (mm3) mm3.textContent = `Continent: ${rot.continentSpec.name} (Teams) • Rotates in ${secPad}s • Max 25`;

      // If currently inside a Joined Lobby, update the lobby countdown and auto-launch when the 1-minute window completes
      if (State.activeLobbyQueue && State.mode === 'menu') {
        if (State.activeLobbyEpoch && rot.epochMinute > State.activeLobbyEpoch) {
          launchFromPublicLobby();
          return;
        }
        const timerEl = document.getElementById('lobby-timer-val');
        if (timerEl) {
          timerEl.textContent = `00:${secPad}`;
        }
        if ((State.activeLobbyPlayers || []).length >= MAX_LOBBY_PLAYERS) {
          launchFromPublicLobby();
        }
      }
    }

    function syncLocalAndCloudLobbyPlayers() {
      if (!State.activeLobbyQueue || !State.activeLobbyEpoch) return;
      const storageKey = getLobbyStorageKey(State.activeLobbyQueue, State.activeLobbyEpoch);
      const mergedMap = new Map();

      // Always include the signed-in human player first
      const myName = State.commanderName || 'Commander';
      mergedMap.set(myName.toLowerCase(), {
        name: myName,
        level: Math.max(1, State.playerLevel || 1),
        isSelf: true
      });

      // Include party members if in a party
      if (State.inParty && Array.isArray(State.partyMembers)) {
        State.partyMembers.forEach(pm => {
          if (pm && !LEGACY_TEST_NAMES.has(String(pm).toLowerCase())) {
            mergedMap.set(String(pm).toLowerCase(), { name: String(pm), level: Math.max(1, State.playerLevel || 1), isSelf: false });
          }
        });
      }

      // Read cross-tab localStorage lobby roster
      try {
        const raw = localStorage.getItem(storageKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            parsed.forEach(p => {
              const pName = typeof p === 'string' ? p : p?.name;
              if (pName && !LEGACY_TEST_NAMES.has(String(pName).toLowerCase())) {
                const k = String(pName).toLowerCase();
                if (!mergedMap.has(k)) {
                  mergedMap.set(k, { name: String(pName), level: p?.level || 1, isSelf: false });
                }
              }
            });
          }
        }
      } catch (e) {}

      // Merge any players received from Firebase Realtime Database
      if (Array.isArray(State.rtdbSnapshots)) {
        State.rtdbSnapshots.forEach(p => {
          if (p && p.name && !LEGACY_TEST_NAMES.has(String(p.name).toLowerCase())) {
            const k = String(p.name).toLowerCase();
            if (!mergedMap.has(k)) {
              mergedMap.set(k, { name: String(p.name), level: p.level || 1, isSelf: false });
            }
          }
        });
      }

      State.activeLobbyPlayers = Array.from(mergedMap.values()).slice(0, MAX_LOBBY_PLAYERS);
      try {
        localStorage.setItem(storageKey, JSON.stringify(State.activeLobbyPlayers));
      } catch (e) {}
      renderJoinedLobbyUI();
    }

    function renderJoinedLobbyUI() {
      const countBadge = document.getElementById('lobby-count-badge');
      const listEl = document.getElementById('lobby-players-list');
      if (!listEl) return;

      const players = State.activeLobbyPlayers || [];
      if (countBadge) {
        countBadge.textContent = `${players.length} / ${MAX_LOBBY_PLAYERS} PLAYERS`;
      }

      const isTeams = State.activeLobbyQueue === 'blitz_teams';
      listEl.innerHTML = players.map((p, idx) => {
        const teamBadge = isTeams
          ? `<span style="font-family:var(--font-pixel-display); font-size:8.5px; padding:2px 5px; background:${idx % 2 === 0 ? '#0284c7' : '#e11d48'}; color:#fff;">${idx % 2 === 0 ? 'BLUE TEAM' : 'RED TEAM'}</span>`
          : `<span style="font-family:var(--font-pixel-display); font-size:8.5px; color:#38bdf8;">LV.${p.level || 1}</span>`;
        return `
          <div class="lobby-player-pill" style="${p.isSelf ? 'border-color:#38bdf8; background:#0f2442;' : ''}">
