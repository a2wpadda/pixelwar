    function drawCustomizePreviewCanvas() {
      const cvs = document.getElementById('customize-preview-canvas');
      if (!cvs) return;
      const pCtx = cvs.getContext('2d');
      const colObj = CUSTOM_COLORS.find(c => c.id === (State.equippedColor || 'sky_blue')) || CUSTOM_COLORS[0];
      const patId = State.equippedPattern || 'solid';

      for (let y = 0; y < cvs.height; y++) {
        for (let x = 0; x < cvs.width; x++) {
          const isBorder = x < 2 || x >= cvs.width - 2 || y < 2 || y >= cvs.height - 2;
          if (isBorder) {
            pCtx.fillStyle = colObj.border;
          } else if (patId !== 'solid' && isPatternAltPixel(patId, x, y)) {
            pCtx.fillStyle = colObj.alt;
          } else {
            pCtx.fillStyle = colObj.fill;
          }
          pCtx.fillRect(x, y, 1, 1);
        }
      }
    }

