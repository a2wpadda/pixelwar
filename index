    function pickWeightedPoolEntry(pool, weights) {
      const weightedList = [];
      pool.forEach(entry => {
        const w = weights?.[entry.rarity] || 20;
        for (let i = 0; i < w; i++) weightedList.push(entry);
      });
      return weightedList[Math.floor(Math.random() * weightedList.length)] || pool[0];
    }

