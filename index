      });

      // Mouse Down: Supports Left-drag OR Right-drag to pan, and clean Left-click to Spawn/Attack/Place
      canvas.addEventListener('mousedown', (e) => {
        if (State.mode === 'menu') return;
        State.isDragging = true;
        State.dragMoved = false;
        State.dragStartX = e.clientX;
        State.dragStartY = e.clientY;
        State.camStartX = State.camX;
        State.camStartY = State.camY;
      });

      window.addEventListener('mousemove', (e) => {
        if (State.isDragging && State.mode !== 'menu') {
          const dx = e.clientX - State.dragStartX;
          const dy = e.clientY - State.dragStartY;
          if (Math.hypot(dx, dy) > 5) {
            State.dragMoved = true;
          }
          if (State.dragMoved) {
            State.camX = State.camStartX + dx;
            State.camY = State.camStartY + dy;
          }
        }
        updateHoverTooltip(e.clientX, e.clientY);
      });

      window.addEventListener('mouseup', (e) => {
        if (!State.isDragging) return;
        const wasDrag = State.dragMoved;
        State.isDragging = false;

        if (!wasDrag && e.button === 0 && State.mode !== 'menu') {
          handleMapClick(e.clientX, e.clientY);
        }
      });

      canvas.addEventListener('contextmenu', e => e.preventDefault());

      // Smooth Cursor-Centered Scroll Zoom
      canvas.addEventListener('wheel', (e) => {
        if (State.mode === 'menu') return;
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.18 : 0.85;
        const newZoom = Math.min(Math.max(State.zoom * factor, 0.9), 20);
        State.camX = e.clientX - (e.clientX - State.camX) * (newZoom / State.zoom);
        State.camY = e.clientY - (e.clientY - State.camY) * (newZoom / State.zoom);
        State.zoom = newZoom;
      }, { passive: false });

      // Top Left Camera & Match Finish Buttons
      document.getElementById('btn-zoom-in').addEventListener('click', () => {
        const cx = canvas.width / 2, cy = canvas.height / 2;
        const newZoom = Math.min(State.zoom * 1.4, 20);
        State.camX = cx - (cx - State.camX) * (newZoom / State.zoom);
        State.camY = cy - (cy - State.camY) * (newZoom / State.zoom);
        State.zoom = newZoom;
      });

      document.getElementById('btn-zoom-out').addEventListener('click', () => {
        const cx = canvas.width / 2, cy = canvas.height / 2;
        const newZoom = Math.max(State.zoom * 0.7, 0.9);
        State.camX = cx - (cx - State.camX) * (newZoom / State.zoom);
        State.camY = cy - (cy - State.camY) * (newZoom / State.zoom);
        State.zoom = newZoom;
      });

      document.getElementById('btn-reset-view').addEventListener('click', fitWorldView);

      document.getElementById('btn-back-menu').addEventListener('click', () => {
        finishMatchAndAwardStars();
      });

      document.getElementById('btn-results-menu')?.addEventListener('click', () => {
        document.getElementById('modal-results').style.display = 'none';
        State.mode = 'menu';
        State.queueType = 'world';
        State.activeMapSpec = null;
        State.isPublicServerMatch = false;
        applyMatchMapTerrain('world', null);
        populateWorldEntities('world', null, [], false);
        document.getElementById('hud-layer').style.display = 'none';
        const menuLayer = document.getElementById('menu-layer');
        menuLayer.classList.remove('lobby-joined-active');
        menuLayer.style.display = 'flex';
        updatePublicQueueRotationUI();
      });

      document.getElementById('btn-skip-spawn').addEventListener('click', () => {
        if (State.mode === 'spawning' && State.factions[1]?.capital) {
          State.spawnCountdown = 0;
        }
      });

      // Attack % Selector Buttons
      document.querySelectorAll('.btn-dock-pct').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.btn-dock-pct').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const pct = parseInt(btn.dataset.pct);
          State.attackPct = pct / 100;
          document.getElementById('dock-attack-pct-label').textContent = `${pct}%`;
          updateHUD();
        });
      });

      // Play Solo / Play With Party Button
      document.getElementById('btn-play-solo').addEventListener('click', () => startMatch('world', null, [], false));
    }

    function handleMapClick(sx, sy) {
      const { mapX, mapY } = screenToMap(sx, sy);
      if (mapX < 0 || mapX >= MAP_W || mapY < 0 || mapY >= MAP_H) return;

      const idx = mapY * MAP_W + mapX;

      if (State.mode === 'spawning') {
        if (mapTerrain[idx] < 2) return; // Must click land to spawn
        if (mapOwner[idx] > 1) return;
        clearFactionTerritory(1);
        stampSpawnCircle(1, mapX, mapY, SPAWN_CIRCLE_12);
        document.getElementById('btn-skip-spawn').style.display = 'inline-block';
        document.getElementById('countdown-text').textContent = `CAPITAL PLACED! BATTLE STARTS IN: ${Math.ceil(State.spawnCountdown)}s`;

        if (State.zoom < 3.2) {
          const targetZoom = 4.2;
          State.camX = canvas.width / 2 - mapX * targetZoom;
          State.camY = canvas.height / 2 - mapY * targetZoom;
          State.zoom = targetZoom;
        }
        return;
      }

      if (State.mode === 'battle') {
        const human = State.factions[1];
        if (!human || !human.alive) return;

        // Check if a 12-Slot Build Bar item is selected for placement/launch
        if (State.selectedBuildSlot) {
          const item = BUILD_ITEMS.find(b => b.slot === State.selectedBuildSlot);
          if (item) {
            const itemLvl = getItemLevel(item.id);
            const levelMult = 1 + (itemLvl - 1) * 0.25;

            if (item.type === 'building') {
              // Must click inside player's own territory to place a building
              if (mapOwner[idx] === 1) {
                if (State.gold >= item.cost) {
                  State.gold -= item.cost;
                  State.placedBuildings.push({
                    x: mapX,
                    y: mapY,
                    slot: item.slot,
                    id: item.id,
                    isDock: Boolean(item.isDock || item.slotGroup === 'WaterDock'),
                    color: item.color,
                    name: item.name
                  });
                  if (item.isDock || item.slotGroup === 'WaterDock') {
                    human.docksBuilt = (human.docksBuilt || 0) + 1;
                  }
                  human.bonusGoldRate = (human.bonusGoldRate || 0) + Math.round((item.goldRate || 0) * levelMult);
                  human.bonusTroopRate = (human.bonusTroopRate || 0) + Math.round((item.troopRate || 0) * levelMult);
                  human.bonusMaxTroops = (human.bonusMaxTroops || 0) + Math.round((item.maxTroops || 0) * levelMult);
                  human.defBonus = (human.defBonus || 0) + (item.defBonus || 0) * levelMult;
                  human.boatSpeedBonus = (human.boatSpeedBonus || 0) + (item.boatSpeed || 0) * levelMult;
                  updateHUD();
                }
                return;
              }
            } else if (item.type === 'ship') {
              // DOCK REQUIREMENT: Must build at least one Water Dock (Slots 5-6) in territory before launching Ships!
              const hasDock = (human.docksBuilt || 0) > 0 || State.placedBuildings.some(b => b.isDock);
              if (!hasDock) {
                showBuildInfo(null, {
                  title: 'DOCK REQUIRED FIRST!',
                  desc: `You must build a Water Dock (Slots 5 or 6, e.g. Naval Dock / Coastal Pier / Trade Harbor) in your territory before launching ${item.name}!`,
                  sub: 'Select Slot 5 or 6 first'
                });
                return;
              }
              if (State.gold >= item.cost) {
                // Find target shore tile if clicked near coast/continent
                let tx = mapX, ty = mapY;
                if (mapTerrain[idx] < 2) {
                  outerShip: for (let r = 1; r <= 30; r++) {
                    for (let dy = -r; dy <= r; dy++) {
                      for (let dx = -r; dx <= r; dx++) {
                        const nx = mapX + dx, ny = mapY + dy;
                        if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H && mapTerrain[ny * MAP_W + nx] >= 2 && mapOwner[ny * MAP_W + nx] !== 1) {
                          tx = nx; ty = ny;
                          break outerShip;
                        }
                      }
                    }
                  }
                }
                const hasTradeHarbor = State.placedBuildings.some(b => b.id === 'trade_harbor');
                const tradeBonusMult = hasTradeHarbor ? 1.35 : 1.0;
                const boatMeta = {
                  boatRole: item.boatRole || 'assault',
                  speedMult: item.speedMult || 1.0,
                  tradeGold: Math.round((item.tradeGold || 0) * levelMult * tradeBonusMult),
                  missileDmg: Math.round((item.missileDmg || 0) * levelMult),
                  color: item.color
                };
                if (launchBoatInvasion(1, tx, ty, Math.round((item.bonusTroops || 250) * levelMult), boatMeta)) {
                  State.gold -= item.cost;
                  updateHUD();
                }
              }
              return;
            } else if (item.type === 'missile') {
              if (mapTerrain[idx] >= 2 && mapOwner[idx] !== 1 && State.gold >= item.cost) {
                State.gold -= item.cost;
                const startX = human.pixelsCount > 0 ? (human.sumX / human.pixelsCount) : mapX;
                const startY = human.pixelsCount > 0 ? (human.sumY / human.pixelsCount) : mapY;
                State.activeMissiles.push({
                  startX,
                  startY,
                  targetX: mapX,
                  targetY: mapY,
                  progress: 0,
                  radius: item.radius || 7,
                  dmg: Math.round((item.dmg || 450) * levelMult),
                  color: item.color
                });
                updateHUD();
                return;
              }
            }
          }
        }

        if (mapTerrain[idx] < 2) return; // Clicked ocean without ship selected
        const targetOwner = mapOwner[idx];
        if (targetOwner === 1 || areTeammates(1, targetOwner)) return; // Clicked own or teammate land
        launchExpansionOrder(1, targetOwner, mapX, mapY);
      }
    }

    function startMatch(queueType = 'world', mapSpec = null, lobbyPlayers = [], isPublicServer = false) {
      State.queueType = queueType || 'world';
      State.activeMapSpec = mapSpec || null;
      State.isPublicServerMatch = Boolean(isPublicServer);
      State.speedMult = queueType === 'blitz_teams' ? 1.35 : 1.0;
      State.mode = 'spawning';
      State.spawnCountdown = 15.0;
      // Slower, tactical starting Gold & passive Gold income so budget towers like Farm (8K) matter!
      State.gold = 8000;
      State.baseGoldRate = 220;
      State.humanEliminatedRank = null;
      State.selectedBuildSlot = null;
      showBuildInfo(null);

      const menuLayer = document.getElementById('menu-layer');
      menuLayer.classList.remove('lobby-joined-active');
      menuLayer.style.display = 'none';
      document.getElementById('hud-layer').style.display = 'flex';
      document.getElementById('btn-skip-spawn').style.display = 'none';
      document.getElementById('dock-player-name').textContent = State.commanderName;
      const cPill = document.getElementById('countdown-pill');
      cPill.classList.remove('active-war');

      applyMatchMapTerrain(State.queueType, State.activeMapSpec);
      populateWorldEntities(State.queueType, State.activeMapSpec, lobbyPlayers, State.isPublicServerMatch);
      renderBuildHotbar();
      fitWorldView();
      updateHUD();
    }

    /* =========================================================================
       8. SIMULATION LOOP & HUD UPDATES (Paced Gold Economy + Countries / World / Blitz Teams)
       ========================================================================= */
    function updateHUD() {
      const human = State.factions[1];
      if (!human) return;

      const totalSlots = Math.max(2, State.factions.length - 1);
      const aliveFactions = State.factions.slice(1).filter(f => f && f.alive && f.pixelsCount > 0);

      const share = ((human.pixelsCount / Math.max(1, totalLandTiles)) * 100).toFixed(2);
      const mapLabel = State.activeMapSpec?.name || 'the world';
      document.getElementById('dock-player-share').textContent = `${share}% of ${mapLabel}`;
      const aliveHdr = document.getElementById('lb-alive-header');
      if (aliveHdr) {
        if (State.queueType === 'blitz_teams') {
          let bluePx = 0, redPx = 0;
          aliveFactions.forEach(f => {
            if (f.team === 1) bluePx += f.pixelsCount;
            else if (f.team === 2) redPx += f.pixelsCount;
          });
          const bPct = ((bluePx / Math.max(1, totalLandTiles)) * 100).toFixed(1);
          const rPct = ((redPx / Math.max(1, totalLandTiles)) * 100).toFixed(1);
          aliveHdr.textContent = `Blue ${bPct}% vs Red ${rPct}%`;
        } else {
          aliveHdr.textContent = `${aliveFactions.length}/${totalSlots} ${State.isPublicServerMatch ? 'Players' : 'Countries'}`;
        }
      }

      const troopRate = Math.floor((22 + human.pixelsCount * 0.35 + (human.bonusTroopRate || 0)) * State.speedMult);
      document.getElementById('dock-troops-rate').textContent = `+${formatCount(troopRate)}/s`;
      document.getElementById('dock-troops-val').innerHTML =
        `${formatCount(human.troops)} <span style="font-size:11px; color:#64748b; font-weight:normal;">/ ${formatCount(human.maxTroops)}</span>`;

      const fillPct = Math.min(100, (human.troops / Math.max(1, human.maxTroops)) * 100);
      document.getElementById('dock-troops-bar').style.width = `${fillPct}%`;

      const sendAmt = Math.floor(human.troops * State.attackPct);
      document.getElementById('dock-attack-subtext').textContent = `Sends ${formatCount(sendAmt)} troops`;

      const totalGoldRate = Math.floor(State.baseGoldRate + human.pixelsCount * 1.2 + (human.bonusGoldRate || 0));
      document.getElementById('dock-gold-val').textContent = formatCount(State.gold);
      document.getElementById('dock-gold-rate').textContent = `+${formatCount(totalGoldRate)}/s`;

      // Update hotbar affordability colors dynamically (red when unaffordable, gold when affordable)
      document.querySelectorAll('#dock-hotbar-slots [data-slot-cost]').forEach(el => {
        const sNum = parseInt(el.dataset.slotCost, 10);
        const bItem = BUILD_ITEMS.find(b => b.slot === sNum);
        if (bItem) {
          el.classList.toggle('can-afford', State.gold >= bItem.cost);
        }
      });

      // Update Top 6 Leaderboard
      const topRanked = aliveFactions.sort((a, b) => b.pixelsCount - a.pixelsCount).slice(0, 6);
      const lbContainer = document.getElementById('lb-rows');
      lbContainer.innerHTML = topRanked.map((f, idx) => {
        const pct = ((f.pixelsCount / Math.max(1, totalLandTiles)) * 100).toFixed(2);
        const bold = f.isHuman ? 'font-weight:900; color:#38bdf8;' : '';
        return `<div class="lb-entry" style="${bold}">
          <span>#${idx + 1} <span class="lb-dot" style="background:${f.borderHex};"></span>${f.name}</span>
          <span>${pct}%</span>
        </div>`;
      }).join('');
    }

    let lastTime = performance.now();
    let econAccum = 0;
    let waveAccum = 0;

    function gameLoop(now) {
      requestAnimationFrame(gameLoop);
      const dt = Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;

      // Menu Background Panning
      if (State.mode === 'menu') {
        const menuZoom = Math.max(2.2, (canvas.height * 1.15) / MAP_H);
        State.menuCamX -= State.menuPanSpeed * dt;
        if (State.menuCamX <= -MAP_W * menuZoom) {
          State.menuCamX += MAP_W * menuZoom;
        }
        render();
        return;
      }

      // Spawning Countdown Phase
      if (State.mode === 'spawning') {
        State.spawnCountdown -= dt;
        const cPill = document.getElementById('countdown-pill');
        const cText = document.getElementById('countdown-text');
        const mapTitle = (State.activeMapSpec?.name || 'WORLD').toUpperCase();

        if (State.spawnCountdown > 0) {
          const secs = Math.ceil(State.spawnCountdown);
          if (State.factions[1]?.capital) {
            cText.textContent = `CAPITAL PLACED ON ${mapTitle}! BATTLE STARTS IN: ${secs}s`;
          } else {
            cText.textContent = `${mapTitle} MAP — CLICK ANY LAND TO PLACE CAPITAL: ${secs}s`;
          }
        } else {
          const human = State.factions[1];
          if (human && !human.capital) {
            const fallbackPt = findDistributedLandSpawns(1)[0] || { x: 515, y: 285 };
            stampSpawnCircle(1, fallbackPt.x, fallbackPt.y, SPAWN_CIRCLE_12);
          }
          State.mode = 'battle';
          cPill.classList.add('active-war');
          document.getElementById('btn-skip-spawn').style.display = 'none';
          cText.textContent = `${mapTitle} WAR IN PROGRESS — CLICK LAND OR SEA TO CONQUER`;
          launchExpansionOrder(1, 0);
        }
      }

      // Battle Phase
      if (State.mode === 'battle') {
        // Step 5-Pixel Cross Boats across oceans
        stepActiveBoats(dt * State.speedMult);

        // Step Active Missiles
        for (let mIdx = State.activeMissiles.length - 1; mIdx >= 0; mIdx--) {
          const m = State.activeMissiles[mIdx];
          m.progress += dt * 1.35;
          if (m.progress >= 1) {
            // Detonate missile crater & damage enemy troops
            const hitOwner = mapOwner[m.targetY * MAP_W + m.targetX];
            if (hitOwner > 1 && !areTeammates(1, hitOwner) && State.factions[hitOwner]) {
              State.factions[hitOwner].troops = Math.max(0, State.factions[hitOwner].troops - m.dmg);
            }
            const r = m.radius;
            for (let dy = -r; dy <= r; dy++) {
              for (let dx = -r; dx <= r; dx++) {
                if (dx * dx + dy * dy <= r * r) {
                  const nx = m.targetX + dx, ny = m.targetY + dy;
                  if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H && mapTerrain[ny * MAP_W + nx] >= 2) {
                    const tileOwner = mapOwner[ny * MAP_W + nx];
                    if (tileOwner !== 1 && !areTeammates(1, tileOwner)) {
                      claimTile(nx, ny, 0); // Neutralizes blasted enemy tiles for easy capture!
                    }
                  }
                }
              }
            }
            State.activeMissiles.splice(mIdx, 1);
          }
        }

        // Smooth Concentric Wave Expansion (measured 0.085s cadence)
        waveAccum += dt * State.speedMult;
        while (waveAccum >= 0.085) {
          stepActiveWaves();
          waveAccum -= 0.085;
        }

        // Calm, balanced Economy & AI Tick every 0.5s
        econAccum += dt * State.speedMult;
        if (econAccum >= 0.5) {
          econAccum -= 0.5;

          for (let i = 1; i < State.factions.length; i++) {
            const f = State.factions[i];
            if (!f || !f.alive || f.pixelsCount === 0) continue;

            f.maxTroops = Math.max(3000, f.pixelsCount * 24 + (f.bonusMaxTroops || 0));
            const growth = Math.floor(11 + f.pixelsCount * 0.175 + (f.bonusTroopRate || 0) * 0.5);
            f.troops = Math.min(f.maxTroops, f.troops + growth);

            // Calm, strategic AI decisions for Rival Commanders / Countries
            if (!f.isHuman && Math.random() < 0.14 && f.troops > 260) {
              launchExpansionOrder(f.id, 0);
              if (Math.random() < 0.25) {
                const cx = Math.floor(f.sumX / f.pixelsCount);
                const cy = Math.floor(f.sumY / f.pixelsCount);
                const rad = Math.ceil(Math.sqrt(f.pixelsCount / Math.PI)) + 4;
                const probeX = Math.max(0, Math.min(MAP_W - 1, cx + Math.floor((Math.random() - 0.5) * rad * 2.6)));
                const probeY = Math.max(0, Math.min(MAP_H - 1, cy + Math.floor((Math.random() - 0.5) * rad * 2.6)));
                const targetOwner = mapOwner[probeY * MAP_W + probeX];
                if (targetOwner > 0 && targetOwner !== f.id && !areTeammates(f.id, targetOwner)) {
                  launchExpansionOrder(f.id, targetOwner, probeX, probeY);
                }
              }
            }
          }

          const human = State.factions[1];
          const totalGoldRate = State.baseGoldRate + (human ? human.pixelsCount * 1.2 + (human.bonusGoldRate || 0) : 0);
          State.gold += Math.floor(totalGoldRate * 0.5);

          // Sync live match state to Firebase Realtime Database during public matches
          if (State.isPublicServerMatch && State.activeMatchId && rtdbInstance && human && State.commanderName) {
            const cleanId = State.commanderName.toLowerCase().replace(/[^a-z0-9_]/g, '');
            if (cleanId) {
              rtdbInstance.ref(`pixelwar_matches/${State.activeMatchId}/players/${cleanId}`).set({
                name: State.commanderName,
                pixels: human.pixelsCount,
                troops: Math.floor(human.troops),
                team: human.team || 0,
                updatedAt: Date.now()
              }).catch(() => {});
            }
          }

          updateHUD();
        }
      }

      render();
    }

    // Boot
    window.addEventListener('DOMContentLoaded', () => {
      resizeCanvas();
      decodeEarthGrid();
      populateWorldEntities();
      setupSingleStepAuth();
      setupControls();
      requestAnimationFrame(gameLoop);
    });
  </script>
