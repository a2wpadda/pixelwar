       ========================================================================= */
    const firebaseConfig = {
      apiKey: "AIzaSyBLNc9jb4WTxMIZW4UVIKe4lcjhDJXQuFI",
      authDomain: "pixel-war-firebase.firebaseapp.com",
      databaseURL: "https://pixel-war-firebase-default-rtdb.firebaseio.com",
