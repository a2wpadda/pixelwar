    function getAccountKey(username) {
      return 'pixelwar_acct_' + username.toLowerCase().replace(/[^a-z0-9_]/g, '');
    }

    const DEFAULT_STARTER_LOADOUT = [
      'gold_mine', 'central_bank',
      'barracks', 'fortress',
      'naval_dock', 'shipyard',
      'howitzer_battery', 'railgun_tower',
      'gunboat', 'battleship',
      'cruise_missile', 'tsar_warhead'
    ];

    function createDefaultOwnedItems() {
      const map = {};
      DEFAULT_STARTER_LOADOUT.forEach(id => {
        map[id] = { level: 1, cards: 0 };
      });
      return map;
    }

    function getRequiredXPForLevel(level) {
      const lvl = Math.max(1, level || 1);
      return 500 + (lvl - 1) * 250; // Lv.1 needs 500 XP, Lv.2 needs 750 XP, Lv.3 needs 1,000 XP, etc.
    }

    function getMatchmakingBracketLabel(level) {
      const lvl = Math.max(1, level || 1);
      const low = Math.floor((lvl - 1) / 5) * 5 + 1;
      const high = low + 4;
      return `Lv.${low}–${high}`;
    }

    async function loadAccountData(username) {
      const cleanId = username.toLowerCase().replace(/[^a-z0-9_]/g, '');
      const localKey = getAccountKey(username);
      let data = {
        username: username,
        stars: 0,
        diamonds: 0,
        wins: 0,
        losses: 0,
        playerLevel: 1,
        xp: 0,
        incomingInvites: [],
        friends: [],
        crateUpgrades: { Money: 1, Military: 1, Water: 1, Docks: 1, Artillery: 1 },
        ownedItems: createDefaultOwnedItems(),
        loadout: [...DEFAULT_STARTER_LOADOUT],
        unlockedColors: ['sky_blue'],
        equippedColor: 'sky_blue',
        unlockedPatterns: ['solid'],
        equippedPattern: 'solid'
      };

      // 1. Read local per-account storage immediately (0ms delay)
      try {
        const raw = localStorage.getItem(localKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          data = { ...data, ...parsed, username };
        }
      } catch (e) {}

      // Also check cross-tab incoming party invites for this username
      try {
        const invRaw = localStorage.getItem('pixelwar_party_invites_' + cleanId);
        if (invRaw) {
          const parsedInv = JSON.parse(invRaw);
          if (Array.isArray(parsedInv)) {
            data.incomingInvites = Array.from(new Set([...(data.incomingInvites || []), ...parsedInv]));
          }
        }
      } catch (e) {}

      // Automatically purge any legacy test names that may have been cached in localStorage earlier
      const LEGACY_TEST_NAMES = new Set([
        'general_vex', 'pixel_king', 'novacommander', 'ironclad_99',
        'atlas_striker', 'crimsontide', 'valkyrie_hq', 'zerohour_x',
        'blitzkrieg_7', 'omega_sovereign', 'arcticfox_12', 'desertstorm_x', 'squad_ally_1'
      ]);

      State.stars = data.stars || 0;
      State.diamonds = data.diamonds || 0;
      State.wins = data.wins || 0;
      State.losses = data.losses || 0;
      State.playerLevel = Math.max(1, data.playerLevel || 1);
      State.xp = Math.max(0, data.xp || 0);
      State.incomingInvites = (Array.isArray(data.incomingInvites) ? data.incomingInvites : []).filter(
        u => u && !LEGACY_TEST_NAMES.has(String(u).toLowerCase()) && String(u).toLowerCase() !== username.toLowerCase()
      );
      State.friends = (Array.isArray(data.friends) ? data.friends : []).filter(
        f => f && !LEGACY_TEST_NAMES.has(String(f).toLowerCase())
      );
      State.crateUpgrades = data.crateUpgrades || { Money: 1, Military: 1, Water: 1, Docks: 1, Artillery: 1 };
      State.ownedItems = { ...createDefaultOwnedItems(), ...(data.ownedItems || {}) };
      State.loadout = (Array.isArray(data.loadout) && data.loadout.length === 12)
        ? [...data.loadout]
        : [...DEFAULT_STARTER_LOADOUT];
      State.unlockedColors = Array.from(new Set(['sky_blue', ...(Array.isArray(data.unlockedColors) ? data.unlockedColors : [])]));
      State.equippedColor = data.equippedColor || 'sky_blue';
      State.unlockedPatterns = Array.from(new Set(['solid', ...(Array.isArray(data.unlockedPatterns) ? data.unlockedPatterns : [])]));
      State.equippedPattern = data.equippedPattern || 'solid';

      syncActiveLoadoutToBuildItems();
      applyHumanCustomColor();
      saveAccountData();
      refreshAccountUI();
      renderIncomingInvitesUI();

      // 2. Non-blocking background cloud sync (Firestore cross-device save)
      if (dbInstance && cleanId) {
        dbInstance.collection('pixelwar_accounts').doc(cleanId).get().then(snap => {
          if (snap.exists) {
            const cloud = snap.data();
            if (typeof cloud.stars === 'number') State.stars = Math.max(State.stars, cloud.stars);
            if (typeof cloud.diamonds === 'number') State.diamonds = Math.max(State.diamonds, cloud.diamonds);
            if (typeof cloud.wins === 'number') State.wins = Math.max(State.wins, cloud.wins);
            if (typeof cloud.losses === 'number') State.losses = Math.max(State.losses, cloud.losses);
            if (typeof cloud.playerLevel === 'number') {
              if (cloud.playerLevel > State.playerLevel) {
                State.playerLevel = cloud.playerLevel;
                State.xp = cloud.xp || 0;
              } else if (cloud.playerLevel === State.playerLevel) {
                State.xp = Math.max(State.xp, cloud.xp || 0);
              }
            }
            if (Array.isArray(cloud.incomingInvites)) {
              const cleanInv = cloud.incomingInvites.filter(u => u && !LEGACY_TEST_NAMES.has(String(u).toLowerCase()));
              State.incomingInvites = Array.from(new Set([...State.incomingInvites, ...cleanInv]));
            }
            if (Array.isArray(cloud.friends)) {
              const cleanCloudFriends = cloud.friends.filter(f => f && !LEGACY_TEST_NAMES.has(String(f).toLowerCase()));
              State.friends = Array.from(new Set([...State.friends, ...cleanCloudFriends]));
            }
            if (cloud.crateUpgrades) State.crateUpgrades = { ...State.crateUpgrades, ...cloud.crateUpgrades };
            if (cloud.ownedItems) {
              Object.entries(cloud.ownedItems).forEach(([k, v]) => {
                if (!State.ownedItems[k]) {
                  State.ownedItems[k] = v;
                } else {
                  State.ownedItems[k].level = Math.max(State.ownedItems[k].level || 1, v.level || 1);
                  State.ownedItems[k].cards = Math.max(State.ownedItems[k].cards || 0, v.cards || 0);
                }
              });
            }
            if (Array.isArray(cloud.loadout) && cloud.loadout.length === 12) State.loadout = cloud.loadout;
            if (Array.isArray(cloud.unlockedColors)) {
              State.unlockedColors = Array.from(new Set([...State.unlockedColors, ...cloud.unlockedColors]));
            }
            if (cloud.equippedColor) State.equippedColor = cloud.equippedColor;
            if (Array.isArray(cloud.unlockedPatterns)) {
              State.unlockedPatterns = Array.from(new Set([...State.unlockedPatterns, ...cloud.unlockedPatterns]));
            }
            if (cloud.equippedPattern) State.equippedPattern = cloud.equippedPattern;

            syncActiveLoadoutToBuildItems();
            applyHumanCustomColor();
            saveAccountData();
            refreshAccountUI();
            renderIncomingInvitesUI();
          }
        }).catch(() => {});
      }
    }

    function saveAccountData() {
      if (!State.commanderName) return;
      const cleanId = State.commanderName.toLowerCase().replace(/[^a-z0-9_]/g, '');
      const payload = {
        username: State.commanderName,
        stars: State.stars,
        diamonds: State.diamonds,
        wins: State.wins || 0,
        losses: State.losses || 0,
        playerLevel: State.playerLevel || 1,
        xp: State.xp || 0,
        incomingInvites: State.incomingInvites || [],
        friends: State.friends,
        crateUpgrades: State.crateUpgrades,
        ownedItems: State.ownedItems,
        loadout: State.loadout,
        unlockedColors: State.unlockedColors,
        equippedColor: State.equippedColor,
        unlockedPatterns: State.unlockedPatterns,
        equippedPattern: State.equippedPattern,
        updatedAt: Date.now()
      };
      try {
        localStorage.setItem(getAccountKey(State.commanderName), JSON.stringify(payload));
        localStorage.setItem('pixelwar_party_invites_' + cleanId, JSON.stringify(State.incomingInvites || []));
      } catch (e) {}

      if (dbInstance && cleanId) {
        dbInstance.collection('pixelwar_accounts').doc(cleanId).set(payload, { merge: true }).catch(() => {});
      }
    }

    function refreshAccountUI() {
      const sStr = State.stars.toLocaleString();
      const dStr = State.diamonds.toLocaleString();
      document.getElementById('menu-stars-val').textContent = sStr;
      document.getElementById('menu-diamonds-val').textContent = dStr;
      document.getElementById('shop-stars-val').textContent = sStr;
      document.getElementById('shop-diamonds-val').textContent = dStr;
      const upgStars = document.getElementById('upgrades-stars-val');
      const upgDia = document.getElementById('upgrades-diamonds-val');
      if (upgStars) upgStars.textContent = sStr;
      if (upgDia) upgDia.textContent = dStr;

      // Update Bottom-Right Wins, Losses & Giant Level Meter
      const winsEl = document.getElementById('profile-wins-val');
      const lossesEl = document.getElementById('profile-losses-val');
      if (winsEl) winsEl.textContent = (State.wins || 0).toLocaleString();
      if (lossesEl) lossesEl.textContent = (State.losses || 0).toLocaleString();

      const pLvl = Math.max(1, State.playerLevel || 1);
      const curXP = Math.max(0, State.xp || 0);
      const reqXP = getRequiredXPForLevel(pLvl);
      const needXP = Math.max(0, reqXP - curXP);
      const xpPct = Math.min(100, Math.round((curXP / reqXP) * 100));

      const lvlInside = document.getElementById('profile-level-inside');
      const xpInside = document.getElementById('profile-xp-needed-inside');
      const xpFill = document.getElementById('profile-xp-bar-fill');
      if (lvlInside) lvlInside.textContent = `LEVEL ${pLvl}`;
      if (xpInside) xpInside.textContent = `${curXP.toLocaleString()} / ${reqXP.toLocaleString()} XP (NEED ${needXP.toLocaleString()} XP)`;
      if (xpFill) xpFill.style.width = `${xpPct}%`;

      // Update Level-Based Public Server Matchmaking Bracket Labels
      const bracketStr = getMatchmakingBracketLabel(pLvl);
      const mmBracketEl = document.getElementById('profile-mm-bracket');
      if (mmBracketEl) mmBracketEl.textContent = `BRACKET: ${bracketStr.toUpperCase()}`;
      if (typeof updatePublicQueueRotationUI === 'function') {
        updatePublicQueueRotationUI();
      }
    }

    async function completeSignIn(username) {
      State.commanderName = username;
      try {
        localStorage.setItem('pixelwar_remembered_user', username);
      } catch (e) {}

      document.getElementById('welcome-user-text').textContent = `Welcome, Commander ${username}`;
      document.getElementById('dock-player-name').textContent = username;
      document.getElementById('auth-gate-overlay').style.display = 'none';
      document.getElementById('menu-layer').style.display = 'flex';
      if (State.factions[1]) {
        State.factions[1].name = username;
      }
      await loadAccountData(username);
    }

    function setupSingleStepAuth() {
      const userInp = document.getElementById('auth-username');
      const passInp = document.getElementById('auth-password');
      const errBox = document.getElementById('auth-error-box');
      const goBtn = document.getElementById('btn-auth-go');
      const goLabel = document.getElementById('btn-auth-go-label');
      const signOutBtn = document.getElementById('btn-signout');

      function showError(msg) {
        errBox.textContent = msg;
        errBox.style.display = 'block';
      }

      // Auto-Remember Me on Device!
      try {
        const remembered = localStorage.getItem('pixelwar_remembered_user');
        if (remembered) {
          const cleanRem = remembered.toLowerCase().replace(/[^a-z0-9_]/g, '');
          const banned = (typeof PixelWarSync !== 'undefined') ? PixelWarSync.getBanStatus(cleanRem).isBanned : false;
          if (!banned) {
            userInp.value = remembered;
            completeSignIn(remembered);
          }
        }
      } catch (e) {}

      if (authInstance) {
        authInstance.onAuthStateChanged((user) => {
          const remembered = localStorage.getItem('pixelwar_remembered_user');
          if (user && remembered && State.mode === 'menu' && document.getElementById('auth-gate-overlay').style.display !== 'none') {
            completeSignIn(remembered);
          }
        });
      }

      async function handleGo() {
        const rawUser = userInp.value.trim();
        const rawPass = passInp.value;

        if (!rawUser || rawUser.length < 2) {
          showError("Please enter a username (at least 2 characters).");
          return;
        }
        if (!rawPass || rawPass.length < 1) {
          showError("Please enter a password.");
          return;
        }

        const cleanUser = rawUser.toLowerCase().replace(/[^a-z0-9_]/g, '');
        if (!cleanUser) {
          showError("Username must contain letters or numbers.");
          return;
        }

        // Moderation & Inappropriate Name Check
        if (typeof PixelWarSync !== 'undefined') {
          const nameCheck = PixelWarSync.checkInappropriate(rawUser);
          if (nameCheck.isInappropriate) {
            showError(`Inappropriate Username: "${rawUser}" contains prohibited language (${nameCheck.matches.join(', ')}). Please choose another name.`);
            return;
          }
          const banStatus = PixelWarSync.getBanStatus(cleanUser);
          if (banStatus.isBanned) {
            showError(`SUSPENDED: This account has been banned.\nReason: ${banStatus.reason || 'Violation of Community Guidelines'}`);
            return;
          }
          const acc = PixelWarSync.getAccount(cleanUser);
          if (acc && acc.resetPending && acc.resetPassword) {
            if (rawPass !== acc.resetPassword) {
              showError("PASSWORD RESET: Account reset by admin. Please enter your new assigned password.");
              return;
            }
          }
        }

        const internalEmail = `${cleanUser}@pixelwar.com`;
        const internalPass = rawPass + "#PW2026!";

        errBox.style.display = 'none';
        goBtn.disabled = true;
        goLabel.textContent = "CHECKING...";

        if (!authInstance) {
          goBtn.disabled = false;
          goLabel.textContent = "GO";
          completeSignIn(rawUser);
          return;
        }

        try {
          const created = await authInstance.createUserWithEmailAndPassword(internalEmail, internalPass);
          if (created.user) {
            await created.user.updateProfile({ displayName: rawUser });
          }
          goBtn.disabled = false;
          goLabel.textContent = "GO";
          if (typeof PixelWarSync !== 'undefined') {
            PixelWarSync.recordAccount({ username: rawUser, cleanUser: cleanUser, email: internalEmail, lastLogin: Date.now() });
          }
          completeSignIn(rawUser);
        } catch (createErr) {
          if (createErr.code === 'auth/email-already-in-use') {
            try {
              const signedIn = await authInstance.signInWithEmailAndPassword(internalEmail, internalPass);
              const finalName = signedIn.user?.displayName || rawUser;
              goBtn.disabled = false;
              goLabel.textContent = "GO";
              if (typeof PixelWarSync !== 'undefined') {
                PixelWarSync.recordAccount({ username: finalName, cleanUser: cleanUser, email: internalEmail, lastLogin: Date.now() });
              }
              completeSignIn(finalName);
            } catch (signInErr) {
              goBtn.disabled = false;
              goLabel.textContent = "GO";
              showError(`Username '${rawUser}' is already taken or password is wrong!`);
            }
          } else {
            goBtn.disabled = false;
            goLabel.textContent = "GO";
            showError(createErr.message || "Authentication error.");
          }
        }
      }

      goBtn.addEventListener('click', handleGo);
      passInp.addEventListener('keydown', (e) => { if (e.key === 'Enter') handleGo(); });
      userInp.addEventListener('keydown', (e) => { if (e.key === 'Enter') passInp.focus(); });

      signOutBtn.addEventListener('click', () => {
        try { localStorage.removeItem('pixelwar_remembered_user'); } catch (e) {}
        if (authInstance) authInstance.signOut();
        document.getElementById('menu-layer').style.display = 'none';
        document.getElementById('auth-gate-overlay').style.display = 'flex';
        passInp.value = '';
      });

      if (typeof PixelWarSync !== 'undefined') {
        PixelWarSync.subscribe((type, data) => {
          if (type === 'ACCOUNT_BANNED' && State.commanderName) {
            const curClean = State.commanderName.toLowerCase().replace(/[^a-z0-9_]/g, '');
            if (data && data.cleanKey === curClean) {
              alert(`YOUR COMMANDER ACCOUNT HAS BEEN SUSPENDED BY AN ADMINISTRATOR.\nReason: ${data.reason || 'Violation of Community Guidelines'}`);
              try { localStorage.removeItem('pixelwar_remembered_user'); } catch (e) {}
              if (authInstance) authInstance.signOut();
              window.location.reload();
            }
          }
        });
      }
    }

    /* =========================================================================
       2. PURE EARTH PIXEL GRID ENGINE (996 x 498 Real Interactive Tiles)
       ========================================================================= */
    const MAP_W = 996;
    const MAP_H = 498;
    const TOTAL_PX = MAP_W * MAP_H;

    // 0=DeepOcean, 1=CoastalWater, 2=Plains, 3=Desert/Savanna, 4=Highland, 5=Snow/Mountain
    const mapTerrain = new Uint8Array(TOTAL_PX);
    // 0=Unclaimed, 1=HumanPlayer, 2..N=AI Nations & Neutral Tribes
    const mapOwner = new Uint16Array(TOTAL_PX);
    // Base pre-computed 32-bit ABGR terrain color per pixel (with subtle pixel grid texture)
    const baseTerrainCol32 = new Uint32Array(TOTAL_PX);

    // Offscreen Pixel Buffer Canvas (1:1 with MAP_W x MAP_H)
    const mapSurface = document.createElement('canvas');
    mapSurface.width = MAP_W;
    mapSurface.height = MAP_H;
    const mapSurfaceCtx = mapSurface.getContext('2d');
    const mapImgData = mapSurfaceCtx.createImageData(MAP_W, MAP_H);
    const pixelBuf32 = new Uint32Array(mapImgData.data.buffer);

    const TERRAIN_RLE = "";

    function hexToABGR(hex) {
      const c = parseInt(hex.slice(1), 16);
      const r = (c >> 16) & 255;
      const g = (c >> 8) & 255;
      const b = c & 255;
      return (255 << 24) | (b << 16) | (g << 8) | r;
    }

    function rgbToABGR(r, g, b) {
      return (255 << 24) | (b << 16) | (g << 8) | r;
    }

    let totalLandTiles = 0;
    const fullEarthTerrain = new Uint8Array(TOTAL_PX);

    const TERRAIN_BASE_RGB = [
      [61, 123, 171],  // 0: Deep Ocean
      [84, 145, 192],  // 1: Shallow Coastal Water
      [188, 209, 138], // 2: Lush Plains / Grass
      [231, 214, 169], // 3: Desert / Savanna
