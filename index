    // Builds the active mapTerrain for the chosen Queue (Full World, Single Country, or Single Continent)
    function applyMatchMapTerrain(queueType, mapSpec) {
      if (!queueType || queueType === 'world' || !mapSpec || typeof mapSpec.x0 !== 'number') {
        mapTerrain.set(fullEarthTerrain);
        rebuildTerrainColorBuffer();
        return;
      }

      mapTerrain.fill(0); // Ocean surround
      const padX = 68;
      const padY = 34;
      const destW = MAP_W - padX * 2;
      const destH = MAP_H - padY * 2;

      for (let dy = 0; dy < destH; dy++) {
        const sy = Math.min(MAP_H - 1, Math.max(0, Math.floor(mapSpec.y0 + (dy / destH) * mapSpec.h)));
        const ny = (dy / destH) * 2 - 1;
        for (let dx = 0; dx < destW; dx++) {
          const sx = Math.min(MAP_W - 1, Math.max(0, Math.floor(mapSpec.x0 + (dx / destW) * mapSpec.w)));
          const nx = (dx / destW) * 2 - 1;
          // In single-country mode, softly trim extreme outer corners so only the selected country landmass stands out
          if (queueType === 'countries' && (nx * nx + ny * ny > 1.28)) continue;
          const srcT = fullEarthTerrain[sy * MAP_W + sx];
          mapTerrain[(padY + dy) * MAP_W + (padX + dx)] = srcT;
        }
      }

      // Add shallow coastal water ring around cropped landmasses
      for (let y = 2; y < MAP_H - 2; y++) {
        const rowOff = y * MAP_W;
        for (let x = 2; x < MAP_W - 2; x++) {
          const idx = rowOff + x;
          if (mapTerrain[idx] === 0) {
            if (
              mapTerrain[idx - 1] >= 2 ||
              mapTerrain[idx + 1] >= 2 ||
              mapTerrain[idx - MAP_W] >= 2 ||
              mapTerrain[idx + MAP_W] >= 2
            ) {
              mapTerrain[idx] = 1;
            }
          }
        }
      }

      rebuildTerrainColorBuffer();
    }

