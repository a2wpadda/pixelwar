    // Finds well-spaced land spawn points on the currently active mapTerrain (for single-country & single-continent maps)
    function findDistributedLandSpawns(count) {
      const candidates = [];
      for (let y = 38; y < MAP_H - 38; y += 9) {
        for (let x = 72; x < MAP_W - 72; x += 11) {
          if (mapTerrain[y * MAP_W + x] >= 2) {
            candidates.push({ x, y });
          }
        }
      }
      if (candidates.length === 0) {
        return [{ x: Math.floor(MAP_W / 2), y: Math.floor(MAP_H / 2) }];
      }
      const chosen = [];
      const step = Math.max(1, Math.floor(candidates.length / (count + 2)));
      for (let i = 0; i < count; i++) {
        const pt = candidates[(i * step + Math.floor(step / 2)) % candidates.length];
        chosen.push(pt);
      }
      return chosen;
    }

