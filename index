          { border: '#e11d48', fill: '#fda4af' },
          { border: '#65a30d', fill: '#bef264' },
          { border: '#c026d3', fill: '#f0abfc' }
        ];
        const blueTeamShades = [
          { border: '#0284c7', fill: '#7dd3fc' },
          { border: '#2563eb', fill: '#93c5fd' },
          { border: '#0891b2', fill: '#67e8f9' },
          { border: '#0d9488', fill: '#5eead4' }
        ];
        const redTeamShades = [
          { border: '#dc2626', fill: '#fca5a5' },
          { border: '#e11d48', fill: '#fda4af' },
          { border: '#ea580c', fill: '#fdba74' },
          { border: '#b91c1c', fill: '#f87171' }
        ];

        const baseMapName = mapSpec?.name || 'Sector';
        for (let i = 0; i < totalFactions - 1; i++) {
          const id = i + 2;
          const pt = landSpawns[i % landSpawns.length];
          const team = isTeams ? ((i % 2 === 0) ? 2 : 1) : 0;
          let pal = regionPalette[i % regionPalette.length];
          if (isTeams) {
            pal = team === 1 ? blueTeamShades[i % blueTeamShades.length] : redTeamShades[i % redTeamShades.length];
          }
          const rawName = otherLobbyNames[i] || (queueType === 'countries' ? `${baseMapName} Div #${i + 1}` : WORLD_SPAWNS[i % WORLD_SPAWNS.length].name);
          const displayName = isTeams ? `${team === 1 ? '[BLUE]' : '[RED]'} ${rawName}` : rawName;
          const f = createFaction(id, displayName, pal.border, pal.fill, true, false, team);
          State.factions.push(f);
          stampSpawnCircle(id, pt.x, pt.y, SPAWN_CIRCLE_12);
        }
      }

      State.needsBufferSync = true;
      syncPixelBuffer();
    }

    /* =========================================================================
       5. SMOOTH CONCENTRIC EXPANSION WAVES + 5-PIXEL CROSS BOATS
       ========================================================================= */
    function findNearestCoastalPixel(factionId, targetX, targetY) {
      const f = State.factions[factionId];
      if (!f || f.pixelsCount === 0) return null;
      const minX = Math.max(0, f.minX);
      const maxX = Math.min(MAP_W - 1, f.maxX);
      const minY = Math.max(0, f.minY);
      const maxY = Math.min(MAP_H - 1, f.maxY);

      let best = null;
      let bestDist = Infinity;
      for (let y = minY; y <= maxY; y++) {
        const rowOff = y * MAP_W;
        for (let x = minX; x <= maxX; x++) {
          const idx = rowOff + x;
          if (mapOwner[idx] !== factionId) continue;
          const touchesWater =
            (x > 0 && mapTerrain[idx - 1] < 2) ||
            (x < MAP_W - 1 && mapTerrain[idx + 1] < 2) ||
            (y > 0 && mapTerrain[idx - MAP_W] < 2) ||
            (y < MAP_H - 1 && mapTerrain[idx + MAP_W] < 2);
          if (touchesWater) {
            const d = Math.hypot(x - targetX, y - targetY);
            if (d < bestDist) {
              bestDist = d;
              best = { x, y };
            }
          }
        }
      }
      if (!best) {
        best = { x: Math.round(f.sumX / f.pixelsCount), y: Math.round(f.sumY / f.pixelsCount) };
      }
      return best;
    }

    function launchBoatInvasion(attackerId, targetX, targetY, bonusTroops = 0, boatMeta = null) {
      const attacker = State.factions[attackerId];
      if (!attacker || !attacker.alive || attacker.pixelsCount === 0) return false;

      const pct = attacker.isHuman ? State.attackPct : 0.25;
      const committed = Math.floor(attacker.troops * pct) + bonusTroops;
      if (committed < 20) return false;

      const startCoast = findNearestCoastalPixel(attackerId, targetX, targetY);
      if (!startCoast) return false;

      attacker.troops = Math.max(0, attacker.troops - Math.floor(attacker.troops * pct));
      const baseSpd = (11 + (attacker.boatSpeedBonus || 0) * 6) * (boatMeta?.speedMult || 1.0);
      State.activeBoats.push({
        attackerId,
        x: startCoast.x,
        y: startCoast.y,
        targetX,
        targetY,
        troops: committed,
        speed: baseSpd,
        boatRole: boatMeta?.boatRole || 'assault',
        tradeGold: boatMeta?.tradeGold || 0,
        missileDmg: boatMeta?.missileDmg || 0,
        missileCooldown: 1.1,
        boatColor: boatMeta?.color || null
      });
      return true;
    }

    function stepActiveBoats(dt) {
      for (let i = State.activeBoats.length - 1; i >= 0; i--) {
        const b = State.activeBoats[i];
        const attacker = State.factions[b.attackerId];
        if (!attacker || !attacker.alive) {
          State.activeBoats.splice(i, 1);
          continue;
        }
        const dx = b.targetX - b.x;
        const dy = b.targetY - b.y;
        const dist = Math.hypot(dx, dy);
        const step = b.speed * dt;

        // Missile Boats & Carrier Fleets automatically fire missiles at target shore while sailing!
        if (b.boatRole === 'missile' && b.missileDmg > 0) {
          b.missileCooldown = (b.missileCooldown || 1.2) - dt;
          if (b.missileCooldown <= 0 && dist > 6) {
            b.missileCooldown = 1.6;
            State.activeMissiles.push({
              startX: b.x,
              startY: b.y,
              targetX: Math.max(1, Math.min(MAP_W - 2, Math.round(b.targetX + (Math.random() - 0.5) * 8))),
              targetY: Math.max(1, Math.min(MAP_H - 2, Math.round(b.targetY + (Math.random() - 0.5) * 8))),
              progress: 0,
              radius: 4,
              dmg: b.missileDmg,
              color: b.boatColor || '#f43f5e'
            });
          }
        }

        if (dist <= Math.max(2.2, step)) {
          // If Trade Boat, award lump-sum Gold payout on arrival!
          if (b.boatRole === 'trade' && b.tradeGold > 0 && attacker.isHuman) {
            State.gold += b.tradeGold;
            updateHUD();
          }

          // Boat lands on target continent/island! Stamp a beachhead and start smooth wave
          const lx = Math.max(1, Math.min(MAP_W - 2, Math.round(b.targetX)));
          const ly = Math.max(1, Math.min(MAP_H - 2, Math.round(b.targetY)));
          const targetOwner = mapOwner[ly * MAP_W + lx];

          for (const off of BOAT_CROSS_5) {
            const nx = lx + off.dx, ny = ly + off.dy;
            if (nx >= 0 && nx < MAP_W && ny >= 0 && ny < MAP_H && mapTerrain[ny * MAP_W + nx] >= 2) {
              claimTile(nx, ny, b.attackerId);
            }
          }

          State.activeWaves.push({
            attackerId: b.attackerId,
            targetOwnerId: targetOwner === b.attackerId ? 0 : targetOwner,
            troopsRemaining: b.troops,
            focusX: lx,
            focusY: ly,
            frontX: lx,
            frontY: ly
          });
          State.activeBoats.splice(i, 1);
        } else {
          b.x += (dx / dist) * step;
          b.y += (dy / dist) * step;
        }
      }
    }

    function launchExpansionOrder(attackerId, targetOwnerId, clickX = -1, clickY = -1) {
      const attacker = State.factions[attackerId];
      if (!attacker || !attacker.alive || attacker.pixelsCount === 0) return;
      if (targetOwnerId > 0 && areTeammates(attackerId, targetOwnerId)) return;

      // Check if any frontier tile touches targetOwnerId right now
      const minX = Math.max(0, attacker.minX - 2);
      const maxX = Math.min(MAP_W - 1, attacker.maxX + 2);
      const minY = Math.max(0, attacker.minY - 2);
      const maxY = Math.min(MAP_H - 1, attacker.maxY + 2);
      let touchesTarget = false;

      outer: for (let y = minY; y <= maxY; y++) {
        const rowOff = y * MAP_W;
        for (let x = minX; x <= maxX; x++) {
          const idx = rowOff + x;
          if (mapTerrain[idx] < 2 || mapOwner[idx] !== targetOwnerId) continue;
          if (
            (x > 0 && mapOwner[idx - 1] === attackerId) ||
            (x < MAP_W - 1 && mapOwner[idx + 1] === attackerId) ||
            (y > 0 && mapOwner[idx - MAP_W] === attackerId) ||
            (y < MAP_H - 1 && mapOwner[idx + MAP_W] === attackerId)
          ) {
            touchesTarget = true;
            break outer;
          }
        }
      }

      // If player clicked across water or on a non-adjacent continent/island, launch a 5-pixel cross boat!
      if (!touchesTarget && clickX >= 0 && clickY >= 0) {
        launchBoatInvasion(attackerId, clickX, clickY, 0);
        return;
      }
      if (!touchesTarget) return;

      const pct = attacker.isHuman ? State.attackPct : 0.22;
      const committedTroops = Math.floor(attacker.troops * pct);
      if (committedTroops < 15) return;

      attacker.troops -= committedTroops;

      let existing = State.activeWaves.find(w => w.attackerId === attackerId && w.targetOwnerId === targetOwnerId);
      if (existing) {
        existing.troopsRemaining += committedTroops;
        if (clickX >= 0) {
          existing.focusX = clickX;
          existing.focusY = clickY;
        }
        return;
      }

      const cx = attacker.sumX / attacker.pixelsCount;
      const cy = attacker.sumY / attacker.pixelsCount;
      State.activeWaves.push({
        attackerId,
        targetOwnerId,
        troopsRemaining: committedTroops,
        focusX: clickX,
        focusY: clickY,
        frontX: clickX >= 0 ? clickX : cx,
        frontY: clickY >= 0 ? clickY : cy
      });
    }

    function stepActiveWaves() {
      if (State.activeWaves.length === 0) return;

      for (let wIdx = State.activeWaves.length - 1; wIdx >= 0; wIdx--) {
        const wave = State.activeWaves[wIdx];
        const attacker = State.factions[wave.attackerId];
        if (!attacker || !attacker.alive || wave.troopsRemaining <= 4) {
          State.activeWaves.splice(wIdx, 1);
          continue;
        }

        const minX = Math.max(0, attacker.minX - 2);
        const maxX = Math.min(MAP_W - 1, attacker.maxX + 2);
        const minY = Math.max(0, attacker.minY - 2);
        const maxY = Math.min(MAP_H - 1, attacker.maxY + 2);

        const frontier = [];
        for (let y = minY; y <= maxY; y++) {
          const rowOff = y * MAP_W;
          for (let x = minX; x <= maxX; x++) {
            const idx = rowOff + x;
            if (mapTerrain[idx] < 2) continue;
            if (mapOwner[idx] !== wave.targetOwnerId) continue;

            // Count how many cardinal neighbors belong to attacker (higher = smoother concentric fill!)
            let adj = 0;
            if (x > 0 && mapOwner[idx - 1] === wave.attackerId) adj++;
            if (x < MAP_W - 1 && mapOwner[idx + 1] === wave.attackerId) adj++;
            if (y > 0 && mapOwner[idx - MAP_W] === wave.attackerId) adj++;
            if (y < MAP_H - 1 && mapOwner[idx + MAP_W] === wave.attackerId) adj++;

            if (adj > 0) {
              frontier.push({ x, y, adj });
            }
          }
        }

        if (frontier.length === 0) {
          attacker.troops = Math.min(attacker.maxTroops, attacker.troops + wave.troopsRemaining);
          State.activeWaves.splice(wIdx, 1);
          continue;
        }

        // Smooth concentric sorting: prioritize tiles surrounded on 2+ sides, and smoothly curve around territory center or click focus
        const refX = wave.focusX >= 0 ? wave.focusX : (attacker.sumX / Math.max(1, attacker.pixelsCount));
        const refY = wave.focusY >= 0 ? wave.focusY : (attacker.sumY / Math.max(1, attacker.pixelsCount));

        frontier.sort((a, b) => {
          const scoreA = Math.hypot(a.x - refX, a.y - refY) - a.adj * 3.5;
          const scoreB = Math.hypot(b.x - refX, b.y - refY) - b.adj * 3.5;
          return scoreA - scoreB;
        });

        let pixelCost = 5;
        const defender = wave.targetOwnerId > 0 ? State.factions[wave.targetOwnerId] : null;
        if (defender && defender.alive) {
          const defDensity = Math.max(1, defender.troops / Math.max(1, defender.pixelsCount));
          const defMult = 1 + (defender.defBonus || 0);
          pixelCost = Math.ceil((8 + defDensity * 1.1) * defMult);
        }

        // Smooth, measured batch size so expansion isn't too fast or jagged
        const batchSize = Math.min(frontier.length, Math.max(3, Math.ceil(frontier.length * 0.25)));
        let conqueredAny = false;
        let sumFX = 0, sumFY = 0, cntF = 0;

        for (let i = 0; i < batchSize; i++) {
          if (wave.troopsRemaining < pixelCost) break;
          wave.troopsRemaining -= pixelCost;
          if (defender && defender.alive) {
            defender.troops = Math.max(0, defender.troops - Math.floor(pixelCost * 0.8));
          }
          claimTile(frontier[i].x, frontier[i].y, wave.attackerId);
          sumFX += frontier[i].x;
          sumFY += frontier[i].y;
          cntF++;
          conqueredAny = true;
        }

        if (cntF > 0) {
          wave.frontX = sumFX / cntF;
          wave.frontY = sumFY / cntF;
        }

        if (!conqueredAny) {
          State.activeWaves.splice(wIdx, 1);
        }
      }
    }

    /* =========================================================================
       6. RENDERING PIPELINE (Crisp Pixel Grid + 5px Boats + Buildings + Troop Numbers)
       ========================================================================= */
    const canvas = document.getElementById('game-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);

    function fitWorldView() {
      const scaleX = (canvas.width * 0.92) / MAP_W;
      const scaleY = (canvas.height * 0.80) / MAP_H;
      State.zoom = Math.max(1.0, Math.min(scaleX, scaleY));
      State.camX = (canvas.width - MAP_W * State.zoom) / 2;
      State.camY = (canvas.height - MAP_H * State.zoom) / 2 - 15;
    }

    function screenToMap(sx, sy) {
      const mapX = Math.floor((sx - State.camX) / State.zoom);
      const mapY = Math.floor((sy - State.camY) / State.zoom);
      return { mapX, mapY };
    }

    function formatCount(n) {
      if (n >= 1000000) return (n / 1000000).toFixed(2) + 'M';
      if (n >= 1000) return (n / 1000).toFixed(2) + 'K';
      return Math.floor(n).toString();
    }

    function render() {
      syncPixelBuffer();

      // Deep ocean backdrop
      ctx.fillStyle = '#3d7bab';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.save();
      ctx.imageSmoothingEnabled = false;

      if (State.mode === 'menu') {
        const menuZoom = Math.max(2.2, (canvas.height * 1.15) / MAP_H);
        const menuY = (canvas.height - MAP_H * menuZoom) / 2;
        ctx.translate(State.menuCamX, menuY);
        ctx.scale(menuZoom, menuZoom);
        ctx.drawImage(mapSurface, 0, 0);
        ctx.drawImage(mapSurface, MAP_W, 0);
        ctx.restore();
        return;
      }

      ctx.translate(State.camX, State.camY);
      ctx.scale(State.zoom, State.zoom);

      // Draw crisp pixel-grid world map
      ctx.drawImage(mapSurface, 0, 0);

      // Draw Placed Buildings on the map (3x3 pixel block with golden/colored core)
      for (const bld of State.placedBuildings) {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(bld.x - 1, bld.y - 1, 3, 3);
        ctx.fillStyle = bld.color || '#fbbf24';
        ctx.fillRect(bld.x, bld.y, 1, 1);
      }

      // Draw Active 5-Pixel Cross Boats (1 center pixel + 1 pixel on each of the 4 sides)
      for (const boat of State.activeBoats) {
        const bx = Math.round(boat.x);
        const by = Math.round(boat.y);
        const f = State.factions[boat.attackerId];
        // Wake line to target
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.lineWidth = Math.max(0.5, 1.0 / State.zoom);
        ctx.beginPath();
        ctx.moveTo(boat.x + 0.5, boat.y + 0.5);
        ctx.lineTo(boat.targetX + 0.5, boat.targetY + 0.5);
        ctx.stroke();

        // 5-pixel cross boat body
        for (const off of BOAT_CROSS_5) {
          ctx.fillStyle = (off.dx === 0 && off.dy === 0) ? '#ffffff' : (f ? f.borderHex : '#38bdf8');
          ctx.fillRect(bx + off.dx, by + off.dy, 1, 1);
        }
      }

      // Draw Active Missile Strikes (Arcs + Blast Rings)
      for (const m of State.activeMissiles) {
        const curX = m.startX + (m.targetX - m.startX) * m.progress;
        const curY = m.startY + (m.targetY - m.startY) * m.progress - Math.sin(m.progress * Math.PI) * 35;
        ctx.strokeStyle = m.color || '#ef4444';
        ctx.lineWidth = Math.max(0.8, 2.0 / State.zoom);
        ctx.beginPath();
        ctx.moveTo(m.startX, m.startY);
        ctx.lineTo(curX, curY);
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(curX - 1, curY - 1, 2, 2);
      }

      // Draw Spawning Hover Preview (4x4 rounded pixel circle + influence ring)
      if (State.mode === 'spawning' && State.hoveredTile) {
        const { mapX, mapY } = State.hoveredTile;
        if (mapX >= 0 && mapX < MAP_W && mapY >= 0 && mapY < MAP_H) {
          const isLand = mapTerrain[mapY * MAP_W + mapX] >= 2;
          ctx.fillStyle = isLand ? 'rgba(56, 189, 248, 0.12)' : 'rgba(244, 63, 94, 0.12)';
          ctx.strokeStyle = isLand ? '#38bdf8' : '#f43f5e';
          ctx.lineWidth = 1.2 / State.zoom;
          ctx.beginPath();
          ctx.arc(mapX + 0.5, mapY + 0.5, 22, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = isLand ? '#0074cc' : '#ef4444';
          for (const off of SPAWN_CIRCLE_12) {
            ctx.fillRect(mapX + off.dx, mapY + off.dy, 1, 1);
          }
        }
      }

      // Draw Player Influence Ring around placed capital during spawning
      const human = State.factions[1];
      if (State.mode === 'spawning' && human && human.capital) {
        ctx.fillStyle = 'rgba(56, 189, 248, 0.10)';
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 1.2 / State.zoom;
        ctx.beginPath();
        ctx.arc(human.capital.x + 0.5, human.capital.y + 0.5, 24, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      }

      ctx.restore();

      // Draw Crisp Territory Names, Troop Counts, and Marching Wave Counters in Screen Space
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let i = 1; i < State.factions.length; i++) {
        const f = State.factions[i];
        if (!f || !f.alive || f.pixelsCount === 0) continue;

        const cx = f.sumX / f.pixelsCount;
        const cy = f.sumY / f.pixelsCount;
        const screenX = State.camX + (cx + 0.5) * State.zoom;
        const screenY = State.camY + (cy + 0.5) * State.zoom;

        if (screenX < -100 || screenX > canvas.width + 100 || screenY < -50 || screenY > canvas.height + 50) continue;

        const approxRadiusPx = Math.sqrt(f.pixelsCount / Math.PI) * State.zoom;
        if (approxRadiusPx < 6) continue;

        const fontSize = Math.max(9, Math.min(32, approxRadiusPx * 0.50));
        ctx.font = `800 ${fontSize.toFixed(1)}px 'Segoe UI', system-ui, sans-serif`;

        ctx.fillStyle = f.isHuman ? '#082f49' : '#1e293b';
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.72)';
        ctx.lineWidth = Math.max(1.5, fontSize * 0.13);

        ctx.strokeText(f.name, screenX, screenY - fontSize * 0.38);
        ctx.fillText(f.name, screenX, screenY - fontSize * 0.38);

        const subFontSize = Math.max(7.5, fontSize * 0.68);
        ctx.font = `800 ${subFontSize.toFixed(1)}px 'Segoe UI', system-ui, sans-serif`;
        const troopStr = formatCount(f.troops);
        ctx.strokeText(troopStr, screenX, screenY + fontSize * 0.45);
        ctx.fillText(troopStr, screenX, screenY + fontSize * 0.45);
      }

      // Draw Live Marching Troop Numbers on Active Expansion/Attack Waves!
      for (const wave of State.activeWaves) {
        if (wave.troopsRemaining <= 5) continue;
        const f = State.factions[wave.attackerId];
        if (!f || !f.alive) continue;
        // Show all human marching troop counters + visible AI waves
        if (!f.isHuman && State.zoom < 2.2) continue;

        const wx = State.camX + (wave.frontX + 0.5) * State.zoom;
        const wy = State.camY + (wave.frontY + 0.5) * State.zoom;
        if (wx < 0 || wx > canvas.width || wy < 0 || wy > canvas.height) continue;

        const label = formatCount(wave.troopsRemaining);
        ctx.font = `900 11px 'Segoe UI', system-ui, sans-serif`;
        const tw = ctx.measureText(label).width + 10;
        ctx.fillStyle = f.isHuman ? 'rgba(2, 132, 199, 0.92)' : 'rgba(15, 23, 42, 0.88)';
        ctx.strokeStyle = f.isHuman ? '#38bdf8' : f.borderHex;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.roundRect(wx - tw / 2, wy - 18, tw, 17, 5);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.fillText(label, wx, wy - 9.5);
      }

      // Draw Live Troop Numbers above Sailing 5-Pixel Cross Boats
      for (const boat of State.activeBoats) {
        const bx = State.camX + (boat.x + 0.5) * State.zoom;
        const by = State.camY + (boat.y + 0.5) * State.zoom;
        if (bx < 0 || bx > canvas.width || by < 0 || by > canvas.height) continue;
        const label = formatCount(boat.troops);
        ctx.font = `900 10.5px 'Segoe UI', system-ui, sans-serif`;
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.5;
        ctx.strokeText(label, bx, by - 9);
        ctx.fillText(label, bx, by - 9);
      }

      ctx.restore();
    }

    /* =========================================================================
       7. HOVER TOOLTIP, 15-SLOT BUILD BAR & MODAL/PARTY CONTROLS
       ========================================================================= */
    function updateHoverTooltip(sx, sy) {
      if (State.mode === 'menu') return;
      const { mapX, mapY } = screenToMap(sx, sy);
      State.hoveredTile = { mapX, mapY };

      const tooltip = document.getElementById('territory-tooltip');
      if (mapX < 0 || mapX >= MAP_W || mapY < 0 || mapY >= MAP_H) {
        tooltip.style.display = 'none';
        return;
      }

      const idx = mapY * MAP_W + mapX;
      const terrain = mapTerrain[idx];
      if (terrain < 2) {
        tooltip.style.display = 'none';
        return;
      }

      tooltip.style.display = 'block';
      const terrainNames = ['Ocean', 'Coast', 'Plains', 'Savanna • Dryland', 'Highland', 'Mountains'];
      const ownerId = mapOwner[idx];

      let nearbyCount = 0;
      for (let i = 1; i < State.factions.length; i++) {
        const f = State.factions[i];
        if (f && f.alive && f.capital && Math.hypot(f.capital.x - mapX, f.capital.y - mapY) < 55) {
          nearbyCount++;
        }
      }

      if (ownerId > 0 && State.factions[ownerId]) {
        const f = State.factions[ownerId];
        document.getElementById('tt-name').textContent = f.name;
        document.getElementById('tt-status').textContent = f.isHuman ? 'YOU' : 'COUNTRY';
        document.getElementById('tt-terrain').textContent = `Country • ${terrainNames[terrain]}`;
        document.getElementById('tt-troops').textContent = formatCount(f.troops);
        const share = ((f.pixelsCount / totalLandTiles) * 100).toFixed(2);
        document.getElementById('tt-crowd').textContent = `Land: ${share}%`;
        document.getElementById('tt-action-text').textContent = f.isHuman
          ? (State.selectedBuildSlot ? 'Click to place selected building here' : 'Your controlled territory')
