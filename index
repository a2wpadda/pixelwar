    function rebuildTerrainColorBuffer() {
      totalLandTiles = 0;
      for (let y = 0; y < MAP_H; y++) {
        for (let x = 0; x < MAP_W; x++) {
          const idx = y * MAP_W + x;
          const t = mapTerrain[idx];
          if (t >= 2) totalLandTiles++;

          const rgb = TERRAIN_BASE_RGB[t] || TERRAIN_BASE_RGB[0];
          const hash = (((x * 374761393) + (y * 668265263)) ^ (x * y)) & 3;
          const delta = t === 0 ? (hash - 1) : (hash - 1) * 3;
          const r = Math.min(255, Math.max(0, rgb[0] + delta));
          const g = Math.min(255, Math.max(0, rgb[1] + delta));
          const b = Math.min(255, Math.max(0, rgb[2] + delta));
          const col32 = rgbToABGR(r, g, b);
          baseTerrainCol32[idx] = col32;
          pixelBuf32[idx] = col32;
        }
      }
      mapSurfaceCtx.putImageData(mapImgData, 0, 0);
    }

    function decodeEarthGrid() {
      let ptr = 0;
      for (let i = 0; i < TERRAIN_RLE.length; i += 2) {
        const t = TERRAIN_RLE.charCodeAt(i) - 48;
        const count = TERRAIN_RLE.charCodeAt(i + 1) - 64;
        for (let k = 0; k < count; k++) {
          const val = t;
          fullEarthTerrain[ptr] = val;
          mapTerrain[ptr] = val;
          ptr++;
        }
      }
      rebuildTerrainColorBuffer();
    }

