    /* FULL-SCREEN TOP-LEVEL PIXELATED CRATE ROLLING OVERLAY (ON TOP OF EVERYTHING) */
    .fullscreen-roller-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(4, 7, 14, 0.94);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      padding: 24px;
      pointer-events: auto;
    }

    .fullscreen-roller-box {
      width: min(920px, 95vw);
      background: #0b1324;
      border: 4px solid #fbbf24;
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.95), 8px 8px 0 #04070e;
      position: relative;
    }

    .roller-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-pixel-display);
      font-size: 14px;
      color: #fbbf24;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .roller-viewport {
      position: relative;
      width: 100%;
      height: 148px;
      background: #050811;
      border: 4px solid #283c60;
      overflow: hidden;
      display: flex;
      align-items: center;
      box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.95);
    }

    .roller-center-marker {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 4px;
      background: #fbbf24;
      transform: translateX(-50%);
      z-index: 10;
      box-shadow: 0 0 14px #fbbf24;
      pointer-events: none;
    }

    .roller-center-marker::before,
    .roller-center-marker::after {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 18px;
      height: 10px;
      background: #fbbf24;
    }

    .roller-center-marker::before { top: 0; }
    .roller-center-marker::after { bottom: 0; }

    .roller-track {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 12px;
      will-change: transform;
    }

    .roller-card {
      width: 128px;
      height: 120px;
      flex-shrink: 0;
      background: #111a2e;
      border: 3px solid #334155;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 10px 6px;
      text-align: center;
      box-shadow: inset 2px 2px 0 #050811;
