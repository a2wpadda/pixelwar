    function sendPartyInviteToUser(targetUser) {
      if (!targetUser) return;
      const cleanTarget = targetUser.toLowerCase().replace(/[^a-z0-9_]/g, '');
      if (!cleanTarget) return;
      try {
        const key = 'pixelwar_party_invites_' + cleanTarget;
        const raw = localStorage.getItem(key);
        const existing = raw ? JSON.parse(raw) : [];
        const updated = Array.from(new Set([...(Array.isArray(existing) ? existing : []), State.commanderName]));
        localStorage.setItem(key, JSON.stringify(updated));
      } catch (e) {}

      if (dbInstance && cleanTarget) {
        dbInstance.collection('pixelwar_accounts').doc(cleanTarget).get().then(snap => {
          const cur = snap.exists && Array.isArray(snap.data()?.incomingInvites) ? snap.data().incomingInvites : [];
          const next = Array.from(new Set([...cur, State.commanderName]));
          dbInstance.collection('pixelwar_accounts').doc(cleanTarget).set({ incomingInvites: next }, { merge: true }).catch(() => {});
        }).catch(() => {});
      }
    }

